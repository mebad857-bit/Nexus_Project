@model (string RoleLabel, string UserName, string? ScopeName, string Text, string Ring, string Grad)
@{
    var links = new[] { ("/", "house", "Public site"), ("/account", "user-round", "My account") };
    var tabs = ViewData["NavTabs"] as (string, string, string)[];
}
<div class="flex h-full min-h-[34rem] flex-col">
    <a href="/" class="flex items-center gap-3 px-2">
        <img src="~/images/brand/logo-mark.png" alt="Nexus Service Marketing logo" class="h-11 w-auto drop-shadow-[0_0_12px_rgba(56,189,248,0.5)]" />
        <span class="leading-tight">
            <span class="block font-display text-base font-bold tracking-[0.22em] text-slate-100">NEXUS</span>
            <span class="block text-[10px] font-medium uppercase tracking-[0.3em] text-slate-500">@Model.RoleLabel</span>
        </span>
    </a>

    <button type="button" data-open-palette class="mt-6 flex w-full items-center gap-2 rounded-xl border border-slate-800 bg-ink-900/70 px-3 py-2 text-xs text-slate-500 transition hover:border-slate-600 hover:text-slate-300">
        <i data-lucide="search" class="h-3.5 w-3.5"></i>
        Quick jump
        <span class="ml-auto flex gap-1"><span class="kbd">Ctrl</span><span class="kbd">K</span></span>
    </button>

    @if (tabs != null && tabs.Length > 0)
    {
        <div class="mt-6 space-y-1">
            <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-slate-600">Workspace</p>
            @foreach (var t in tabs)
            {
                <button type="button" data-tab="@t.Item1" class="side-tab">
                    <i data-lucide="@t.Item3" class="h-4 w-4 shrink-0"></i>
                    <span class="truncate">@t.Item2</span>
                </button>
            }
        </div>
    }

    <div class="mt-6 space-y-1">
        <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-slate-600">Links</p>
        @foreach (var l in links)
        {
            <a href="@l.Item1" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-400 transition hover:bg-indigo-500/10 hover:text-slate-100">
                <i data-lucide="@l.Item2" class="h-4 w-4"></i>
                @l.Item3
            </a>
        }
    </div>

    <div class="mt-auto pt-6">
        <div class="glass rounded-2xl p-4 ring-1 @Model.Ring">
            <div class="flex items-center gap-3">
                <a href="/account" title="Change my photo">@Ui.Thumb(ViewData["UserImage"] as string, Model.UserName, Fmt.Initials(Model.UserName), "h-10 w-10", "rounded-xl", "bg-gradient-to-br font-display text-sm text-white " + Model.Grad)</a>
                <div class="min-w-0">
                    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500">Signed in as</p>
                    <p class="truncate font-display text-sm font-bold text-slate-100">@Model.UserName</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.ScopeName))
            {
                <p class="mt-2 truncate text-xs text-slate-500">@Model.ScopeName</p>
            }
            <form method="post" action="/logout">
                @Html.AntiForgeryToken()
                <button class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-700/80 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-rose-400/50 hover:text-rose-300">
                    <i data-lucide="log-out" class="h-3.5 w-3.5"></i>
                    Sign out
                </button>
            </form>
        </div>
    </div>
</div>
