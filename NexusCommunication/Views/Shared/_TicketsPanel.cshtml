@* Complaint tickets panel, used by the customer portal (raise + follow), the admin desk (assign + oversee) and the technical desk (work + resolve).
   Model = mode: "customer" | "admin" | "technical". Everything inside is driven by wwwroot/js/tickets.js and /api/tickets. *@
@model string
@{
    var mode = Model;
    const string Lbl = "mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500";
    var stats = new[] { ("open", "Open", "inbox", "amber"), ("assigned", "Assigned", "user-check", "cyan"), ("in_progress", "In progress", "wrench", "violet"), ("resolved", "Resolved", "circle-check", "emerald"), ("closed", "Closed", "archive", "rose") };
}
<style>
    .modal-card.tk-modal { width: min(52rem, 100%); }
    .tk-chip { cursor: pointer; text-align: left; transition: transform 0.25s ease, box-shadow 0.25s ease; }
    .tk-chip:hover { transform: translateY(-3px); }
    .tk-chip.on { box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.55), 0 14px 34px -18px rgba(79, 70, 229, 0.5); }
    .tk-card { display: block; width: 100%; text-align: left; cursor: pointer; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
    .tk-card:hover { transform: translateY(-3px); border-color: rgba(99, 102, 241, 0.45); box-shadow: 0 18px 44px -24px rgba(79, 70, 229, 0.35); }
    .tk-card:focus-visible, .tk-chip:focus-visible { outline: 3px solid rgba(99, 102, 241, 0.45); outline-offset: 2px; }

    .tk-steps { display: flex; align-items: flex-start; }
    .tk-step { position: relative; flex: 1; text-align: center; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; }
    .tk-step::before { content: ""; position: absolute; top: 0.8rem; left: -50%; width: 100%; height: 2px; background: #e2e8f0; z-index: 0; }
    .tk-step:first-child::before { display: none; }
    .tk-dot { position: relative; z-index: 1; display: grid; place-items: center; width: 1.7rem; height: 1.7rem; margin: 0 auto 0.4rem; border-radius: 999px; background: #fff; border: 2px solid #cbd5e1; color: #94a3b8; }
    .tk-dot svg { width: 0.85rem; height: 0.85rem; }
    .tk-step.done { color: #4f46e5; }
    .tk-step.done::before { background: linear-gradient(90deg, #2563eb, #7c3aed); }
    .tk-step.done .tk-dot { background: linear-gradient(135deg, #2563eb, #7c3aed); border-color: transparent; color: #fff; }
    .tk-step.now .tk-dot { box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2); }
    .tk-step.now { color: #1e293b; }

    .tk-thread { display: flex; flex-direction: column; gap: 0.7rem; max-height: 19rem; overflow-y: auto; padding: 0.25rem 0.25rem 0.25rem 0; overscroll-behavior: contain; }
    .tk-msg { max-width: 86%; border-radius: 1rem; padding: 0.7rem 0.9rem; border: 1px solid #e2e8f0; background: #fff; }
    .tk-msg.me { align-self: flex-end; background: linear-gradient(150deg, rgba(37, 99, 235, 0.08), rgba(124, 58, 237, 0.1)); border-color: rgba(99, 102, 241, 0.25); }
    .tk-msg .who { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.72rem; font-weight: 700; color: #334155; }
    .tk-msg .role { border-radius: 999px; padding: 0.05rem 0.5rem; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; background: rgba(99, 102, 241, 0.12); color: #4f46e5; }
    .tk-msg .when { margin-left: auto; font-weight: 500; color: #94a3b8; }
    .tk-msg p { margin: 0.35rem 0 0; font-size: 0.85rem; line-height: 1.5; color: #1e293b; white-space: pre-line; overflow-wrap: anywhere; }
    .tk-sys { align-self: center; display: inline-flex; align-items: center; gap: 0.4rem; border-radius: 999px; background: #f1f5ff; padding: 0.25rem 0.75rem; font-size: 0.7rem; color: #64748b; text-align: center; }
    .tk-sys b { font-weight: 600; color: #94a3b8; }
    .tk-photo { display: block; margin-top: 0.55rem; overflow: hidden; border-radius: 0.8rem; border: 1px solid #e2e8f0; max-width: 15rem; }
    .tk-photo img { display: block; width: 100%; max-height: 11rem; object-fit: cover; }
</style>

<div data-tickets data-mode="@mode">
@if (mode == "customer")
{
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="glass-strong self-start overflow-hidden rounded-3xl lg:col-span-1">
            <figure class="relative aspect-[16/9] overflow-hidden border-b border-slate-800/80 bg-gradient-to-br from-cyan-500/10 to-violet-600/10">
                <img src="@Ui.Asset("/images/hero/ticket-support")" alt="Nexus support team" loading="lazy" onerror="this.parentElement.style.display='none'" class="absolute inset-0 h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent"></div>
                <figcaption class="absolute bottom-3 left-4 rounded-full bg-ink-950/60 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-100 backdrop-blur">We usually reply within a day</figcaption>
            </figure>
            <div class="p-7">
                <h3 class="font-display text-lg font-bold text-slate-100">Raise a complaint</h3>
                <p class="mt-1.5 text-sm text-slate-500">Tell us what is wrong. Our technical desk will pick it up and you can follow every reply here.</p>
                <form id="tk-form" class="mt-6 space-y-4" novalidate>
                    <label class="block">
                        <span class="@Lbl">Category</span>
                        <select id="tk-category" required class="field">
                            <option value="">Select…</option>
                            @foreach (var c in TicketCategories.All) { <option value="@c">@c</option> }
                        </select>
                    </label>
                    <label class="block">
                        <span class="@Lbl">Subject</span>
                        <input id="tk-subject" required minlength="5" maxlength="200" placeholder="e.g. No internet since morning" class="field" />
                    </label>
                    <label class="block">
                        <span class="@Lbl">Description</span>
                        <textarea id="tk-desc" rows="5" required minlength="10" maxlength="4000" placeholder="What happened, since when, and anything you already tried…" class="field resize-none"></textarea>
                    </label>
                    <div>
                        <span class="@Lbl">Photo (optional)</span>
                        <div class="flex items-center gap-3">
                            <span class="relative grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-xl bg-gradient-to-br from-cyan-500/20 to-violet-500/20 ring-1 ring-cyan-400/30">
                                <i data-lucide="image-plus" class="h-5 w-5 text-cyan-300"></i>
                                <img id="tk-preview" alt="Photo preview" class="absolute inset-0 hidden h-full w-full object-cover" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <input id="tk-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="field !py-2 text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-cyan-400/15 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-cyan-300" />
                                <p class="mt-1 text-xs text-slate-600">JPG, PNG, WEBP or GIF · max 3 MB</p>
                            </div>
                        </div>
                    </div>
                    <p id="tk-error" class="text-sm text-rose-300"></p>
                    <button id="tk-submit" class="btn-glow flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white disabled:opacity-60">
                        <span data-icon-slot><i data-lucide="send" class="h-4 w-4"></i></span> Submit complaint
                    </button>
                </form>
            </div>
        </div>

        <div class="space-y-4 lg:col-span-2">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <div>
                    <h3 class="font-display text-lg font-bold text-slate-100">My complaints</h3>
                    <p id="tk-summary" class="mt-1 text-sm text-slate-500">Loading…</p>
                </div>
                <select id="tk-filter" aria-label="Filter complaints by status" class="field !w-auto !py-2 text-xs">
                    <option value="">All complaints</option>
                    @foreach (var st in TicketStatus.All) { <option value="@st">@TicketStatus.Label(st)</option> }
                </select>
            </div>
            <div id="tk-list" class="space-y-3" aria-live="polite"></div>
        </div>
    </div>
}
else
{
    <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5">
        @foreach (var (key, label, icon, tone) in stats)
        {
            var t = tone switch
            {
                "violet" => "from-violet-500/20 to-fuchsia-500/5 text-violet-300",
                "emerald" => "from-emerald-500/20 to-teal-500/5 text-emerald-300",
                "amber" => "from-amber-500/20 to-orange-500/5 text-amber-300",
                "rose" => "from-slate-500/15 to-slate-400/5 text-slate-500",
                _ => "from-cyan-500/20 to-sky-500/5 text-cyan-300",
            };
            <button type="button" data-tk-chip="@key" class="glass tk-chip rounded-2xl p-4">
                <span class="flex items-center justify-between">
                    <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">@label</span>
                    <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br @t"><i data-lucide="@icon" class="h-4 w-4"></i></span>
                </span>
                <span data-tk-count="@key" class="mt-2 block font-display text-2xl font-bold tracking-tight text-slate-100">–</span>
            </button>
        }
    </div>

    <div class="glass overflow-hidden rounded-3xl">
        <div class="tt-bar">
            <select id="tk-filter" aria-label="Filter by status" class="field !w-auto !py-2 text-xs">
                <option value="">All statuses</option>
                @foreach (var st in TicketStatus.All) { <option value="@st">@TicketStatus.Label(st)</option> }
            </select>
            <div class="tt-search"><i data-lucide="search"></i><input type="search" id="tk-q" class="field" placeholder="Search ticket, customer, subject…" aria-label="Search tickets" /></div>
            <span class="tt-count" id="tk-count" aria-live="polite"></span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[860px] text-sm">
                <thead><tr class="border-b border-slate-800 text-left">
                    @foreach (var h in new[] { "Ticket", "Customer", "Category", "Status", "Assigned to", "Updated", "" })
                    {
                        <th class="px-5 py-4 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500">@h</th>
                    }
                </tr></thead>
                <tbody id="tk-body"><tr><td colspan="7" class="px-5 py-10 text-center text-sm text-slate-500">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="tt-pager" id="tk-pager" hidden>
            <span data-info></span>
            <div class="flex gap-2"><button type="button" data-prev>Previous</button><button type="button" data-next>Next</button></div>
        </div>
    </div>
}
</div>
