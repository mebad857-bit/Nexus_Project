@* Demo online payment ("Pay now"): styles + the two picture paths used by wwwroot/js/payments.js. Rendered once, inside the customer's Bills tab. *@
<div id="pay-config" hidden data-banner="@Ui.Asset("/images/hero/pay-demo-banner")" data-success="@Ui.Asset("/images/hero/payment-success")"></div>
<style>
    .modal-card.pay-modal { width: min(34rem, 100%); padding: 0; overflow-x: hidden; }
    .pay-body { padding: 1.5rem 1.75rem 1.75rem; }
    .pay-banner { position: relative; aspect-ratio: 16 / 5; overflow: hidden; background: linear-gradient(120deg, rgba(37, 99, 235, 0.14), rgba(124, 58, 237, 0.16)); }
    .pay-banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .pay-banner::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(255, 255, 255, 0.9)); }
    .pay-demo { display: flex; align-items: flex-start; gap: 0.6rem; border: 1.5px dashed #d97706; background: #fffbeb; color: #92400e; border-radius: 0.9rem; padding: 0.6rem 0.8rem; font-size: 0.75rem; line-height: 1.45; }
    .pay-demo b { display: inline-block; margin-right: 0.35rem; border-radius: 999px; background: #f59e0b; color: #fff; padding: 0.05rem 0.55rem; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; }
    .pay-methods { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.55rem; }
    .pay-method { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; border: 1.5px solid #d5ddf3; background: #fff; border-radius: 0.95rem; padding: 0.75rem 0.4rem; font-size: 0.78rem; font-weight: 700; color: #475569; cursor: pointer; transition: all 0.2s ease; }
    .pay-method:hover { border-color: rgba(79, 70, 229, 0.5); color: #4f46e5; }
    .pay-method.on { border-color: #4f46e5; background: linear-gradient(150deg, rgba(37, 99, 235, 0.07), rgba(124, 58, 237, 0.1)); color: #3730a3; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15); }
    .pay-method svg { width: 1.3rem; height: 1.3rem; }
    .pay-test { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.72rem; color: #64748b; }
    .pay-test button { border: 1px solid #d5ddf3; background: #fff; border-radius: 999px; padding: 0.2rem 0.7rem; font-size: 0.7rem; font-weight: 700; color: #4338ca; cursor: pointer; transition: all 0.2s ease; }
    .pay-test button:hover { background: #4f46e5; border-color: #4f46e5; color: #fff; }

    .pay-center { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 2.5rem 1.75rem; }
    .pay-ring { width: 4.5rem; height: 4.5rem; border-radius: 999px; border: 5px solid rgba(99, 102, 241, 0.16); border-top-color: #4f46e5; border-right-color: #7c3aed; animation: payspin 0.9s linear infinite; }
    @@keyframes payspin { to { transform: rotate(360deg); } }
    .pay-bar { width: 14rem; height: 5px; margin-top: 1.4rem; overflow: hidden; border-radius: 99px; background: #e2e8ff; }
    .pay-bar i { display: block; height: 100%; width: 0; border-radius: 99px; background: linear-gradient(90deg, #2563eb, #7c3aed); }
    .pay-icon { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 999px; animation: paypop 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
    .pay-icon.ok { background: rgba(16, 185, 129, 0.14); color: #059669; }
    .pay-icon.bad { background: rgba(244, 63, 94, 0.12); color: #e11d48; }
    .pay-icon svg { width: 2.2rem; height: 2.2rem; stroke-width: 3; }
    @@keyframes paypop { 0% { transform: scale(0.4); opacity: 0; } 70% { transform: scale(1.12); } 100% { transform: scale(1); opacity: 1; } }
    .pay-rows { width: 100%; margin-top: 1.4rem; border-top: 1px solid #e2e8f0; text-align: left; }
    .pay-rows div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid #e2e8f0; font-size: 0.85rem; }
    .pay-rows span:first-child { color: #64748b; }
    .pay-rows span:last-child { font-weight: 600; color: #1e293b; text-align: right; overflow-wrap: anywhere; }
    @@media (prefers-reduced-motion: reduce) { .pay-ring { animation-duration: 2.4s; } .pay-icon { animation: none; } }
</style>
