<style type="text/tailwindcss">
@@theme {
  /* palette — Nexus Daylight (white · blue · purple) */
  --color-ink-950: #f5f7ff;
  --color-ink-900: #ffffff;
  --color-ink-850: #fafbff;
  --color-ink-800: #f0f3ff;
  --color-ink-700: #e2e8ff;
  --color-glow-cyan: #3b82f6;
  --color-glow-teal: #6366f1;
  --color-glow-violet: #7c3aed;
  --color-glow-blue: #2563eb;

  /* neutral text / border scale (re-pointed for a light surface) */
  --color-slate-100: #0f172a;
  --color-slate-200: #1e293b;
  --color-slate-300: #334155;
  --color-slate-400: #475569;
  --color-slate-500: #64748b;
  --color-slate-600: #94a3b8;
  --color-slate-700: #cbd5e1;
  --color-slate-800: #e2e8f0;
  --color-slate-900: #eef2ff;

  /* accent families -> blue / indigo / purple */
  --color-cyan-100: #dbe6ff;
  --color-cyan-200: #c3d3ff;
  --color-cyan-300: #2563eb;
  --color-cyan-400: #3b82f6;
  --color-cyan-500: #4f6ef5;
  --color-cyan-600: #4f46e5;
  --color-cyan-700: #3730a3;
  --color-sky-200: #c7dcff;
  --color-sky-300: #2f6fe0;
  --color-sky-400: #4f8ff7;
  --color-sky-500: #3b82f6;
  --color-sky-600: #2563eb;
  --color-violet-300: #7c3aed;
  --color-violet-400: #8b5cf6;
  --color-violet-500: #7c4dff;
  --color-violet-600: #6d28d9;
  --color-teal-300: #0f766e;
  --color-teal-400: #14b8a6;
  --color-emerald-300: #059669;
  --color-emerald-400: #10b981;
  --color-rose-300: #e11d48;
  --color-rose-400: #f43f5e;
  --color-amber-300: #b45309;
  --color-amber-400: #f59e0b;

  /* type */
  --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;

  /* motion */
  --animate-marquee: marquee 42s linear infinite;
  --animate-float: float 7s ease-in-out infinite;
  --animate-float-slow: float 11s ease-in-out infinite;
  --animate-pulse-ring: pulse-ring 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  --animate-spin-slow: spin 14s linear infinite;
  --animate-shimmer: shimmer 2.8s linear infinite;
  --animate-aurora: aurora 16s ease-in-out infinite alternate;
}

@@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-16px); }
}
@@keyframes pulse-ring {
  0% { transform: scale(0.9); opacity: 0.7; }
  70% { transform: scale(1.6); opacity: 0; }
  100% { transform: scale(1.6); opacity: 0; }
}
@@keyframes shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
@@keyframes aurora {
  0% { transform: translate(-8%, -4%) rotate(-2deg) scale(1); }
  50% { transform: translate(6%, 3%) rotate(2deg) scale(1.08); }
  100% { transform: translate(-4%, 6%) rotate(-1deg) scale(1.05); }
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: #f5f7ff;
  background-image: radial-gradient(ellipse 80% 50% at 15% -10%, rgba(99, 102, 241, 0.12), transparent 60%), radial-gradient(ellipse 70% 45% at 95% 0%, rgba(124, 58, 237, 0.10), transparent 60%);
  background-attachment: fixed;
  overflow-x: hidden;
}

::selection {
  background: rgba(99, 102, 241, 0.28);
  color: #1e1b4b;
}

::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}
::-webkit-scrollbar-track {
  background: #eef2ff;
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #60a5fa, #8b5cf6);
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, #2563eb, #6d28d9);
}

@@layer components {
/* ---------- reusable utilities ---------- */

/* logo artwork has white lettering: give it a deep-blue edge so it reads on white */
img[src*="brand/logo"] { filter: drop-shadow(0 0 1px rgba(30, 58, 138, 0.9)) drop-shadow(0 4px 14px rgba(79, 70, 229, 0.35)); }

.glass {
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.92), rgba(244, 247, 255, 0.78));
  border: 1px solid rgba(99, 102, 241, 0.16);
  box-shadow: 0 10px 34px -18px rgba(79, 70, 229, 0.25);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.glass-strong {
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.97), rgba(246, 248, 255, 0.94));
  border: 1px solid rgba(99, 102, 241, 0.18);
  box-shadow: 0 16px 44px -24px rgba(79, 70, 229, 0.3);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.text-gradient {
  background: linear-gradient(100deg, #1d4ed8 10%, #4f46e5 50%, #9333ea 92%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.text-gradient-soft {
  background: linear-gradient(100deg, #334155, #3b82f6 60%, #8b5cf6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.grid-bg {
  background-image:
    linear-gradient(rgba(79, 70, 229, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(79, 70, 229, 0.07) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, black 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, black 30%, transparent 75%);
}

.noise::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.5;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
}

.ring-conic {
  background: conic-gradient(from 180deg, #3b82f6, #8b5cf6, #6366f1, #3b82f6);
}

.shimmer-line {
  background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.6), transparent);
  background-size: 200% 100%;
  animation: shimmer 3.2s linear infinite;
}

.card-hover {
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease, box-shadow 0.5s ease;
}
.card-hover:hover {
  transform: translateY(-6px);
  border-color: rgba(99, 102, 241, 0.45);
  box-shadow: 0 24px 60px -24px rgba(79, 70, 229, 0.3), 0 8px 30px -12px rgba(139, 92, 246, 0.25);
}

.field {
  width: 100%;
  border-radius: 0.85rem;
  border: 1px solid #d5ddf3;
  background: #ffffff;
  padding: 0.7rem 1rem;
  font-size: 0.875rem;
  color: #1e293b;
  outline: none;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}
.field::placeholder {
  color: #94a3b8;
}
.field:focus {
  border-color: rgba(79, 70, 229, 0.65);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.16);
}

.btn-glow {
  position: relative;
  background: linear-gradient(100deg, #2563eb, #4f46e5 55%, #7c3aed);
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, filter 0.3s ease;
  box-shadow: 0 10px 30px -12px rgba(79, 70, 229, 0.6);
}
.btn-glow:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
  box-shadow: 0 18px 40px -12px rgba(99, 102, 241, 0.6);
}

.table-row {
  border-bottom: 1px solid #e6ebfa;
  transition: background 0.2s ease;
}
.table-row:hover {
  background: rgba(99, 102, 241, 0.06);
}

input[type="date"]::-webkit-calendar-picker-indicator {
  filter: none;
}

/* ---------- behaviours that React/framer-motion handled (ported to plain CSS) ---------- */

/* scroll-reveal (framer whileInView) */
.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s), transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s);
}
.reveal.in { opacity: 1; transform: none; }

/* hero entrance (framer animate) */
.fade-up {
  opacity: 0;
  animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: var(--d, 0s);
}
@@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to { opacity: 1; transform: none; }
}

/* top navigation: transparent -> glass when scrolled */
.hdr { padding: 1.25rem 0; background: transparent; transition: all 0.5s; }
.hdr.scrolled {
  padding: 0.75rem 0;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(99, 102, 241, 0.16);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  box-shadow: 0 14px 40px -24px rgba(79, 70, 229, 0.4);
}

/* pill tab bar used by every dashboard */
.tab-btn { color: #64748b; }
.tab-btn:hover { color: #1e293b; }
.tab-btn.active { color: #fff; box-shadow: 0 10px 18px -6px rgba(79, 70, 229, 0.45); }
[data-accent="cyan"] .tab-btn.active { background-image: linear-gradient(to right, rgba(59, 130, 246, 0.95), rgba(99, 102, 241, 0.95)); }
[data-accent="emerald"] .tab-btn.active { background-image: linear-gradient(to right, rgba(16, 185, 129, 0.8), rgba(13, 148, 136, 0.8)); }
[data-accent="amber"] .tab-btn.active { background-image: linear-gradient(to right, rgba(245, 158, 11, 0.8), rgba(234, 88, 12, 0.8)); }
[data-accent="violet"] .tab-btn.active { background-image: linear-gradient(to right, rgba(124, 58, 237, 0.95), rgba(168, 85, 247, 0.9)); }
[data-accent="sky"] .tab-btn.active { background-image: linear-gradient(to right, rgba(37, 99, 235, 0.95), rgba(79, 70, 229, 0.9)); }

/* plans type switch (framer layoutId pill) */
.plan-tab { color: #64748b; }
.plan-tab:hover { color: #1e293b; }
.plan-tab.active { color: #fff; background-image: linear-gradient(to right, #3b82f6, #6366f1); }

/* small segmented toggle (retail: new / existing customer) */
.seg { color: #64748b; }
.seg.active { background: rgba(139, 92, 246, 0.8); color: #fff; }

/* plans panel cross-fade */
.plan-panel { animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1); }

/* ---------- v2 interaction layer: toasts, dialogs, tables, palette, sidebar tabs, charts ---------- */

/* keyboard focus is always visible */
:focus-visible { outline: 2px solid rgba(79, 70, 229, 0.85); outline-offset: 2px; border-radius: 0.6rem; }

/* toasts */
.toast-wrap { position: fixed; right: 1rem; bottom: 1rem; z-index: 200; display: flex; flex-direction: column; gap: 0.6rem; width: min(24rem, calc(100vw - 2rem)); pointer-events: none; }
.toast {
  pointer-events: auto; display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.85rem 1rem; border-radius: 1rem;
  background: #ffffff; border: 1px solid rgba(99, 102, 241, 0.22);
  box-shadow: 0 18px 44px -18px rgba(49, 46, 129, 0.4); font-size: 0.85rem; color: #1e293b; animation: toastIn 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}
.toast.out { opacity: 0; transform: translateX(24px); transition: all 0.3s ease; }
.toast[data-type="success"] { border-color: rgba(52, 211, 153, 0.45); }
.toast[data-type="error"] { border-color: rgba(251, 113, 133, 0.5); }
.toast[data-type="warn"] { border-color: rgba(251, 191, 36, 0.45); }
.toast .t-icon { margin-top: 1px; flex-shrink: 0; }
.toast[data-type="success"] .t-icon { color: #059669; }
.toast[data-type="error"] .t-icon { color: #e11d48; }
.toast[data-type="warn"] .t-icon { color: #d97706; }
.toast[data-type="info"] .t-icon { color: #4f46e5; }
@@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.97); } to { opacity: 1; transform: none; } }

/* dialogs */
.modal-back { position: fixed; inset: 0; z-index: 150; display: grid; place-items: center; padding: 1rem; background: rgba(30, 27, 75, 0.45); backdrop-filter: blur(6px); animation: fadeIn 0.2s ease; }
.modal-card { width: min(44rem, 100%); max-height: calc(100vh - 2rem); overflow-y: auto; border-radius: 1.5rem; padding: 1.75rem; animation: popIn 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
.modal-card.sm { width: min(26rem, 100%); }
@@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@@keyframes popIn { from { opacity: 0; transform: translateY(18px) scale(0.97); } to { opacity: 1; transform: none; } }

/* data tables (search / sort / paging are added by site.js to every [data-table]) */
[data-tt-hidden] { display: none !important; }
.tt-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; padding: 0.9rem 1.25rem; border-bottom: 1px solid #e6ebfa; }
.tt-search { position: relative; flex: 1 1 14rem; max-width: 24rem; }
.tt-search input { padding-left: 2.4rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
.tt-search i, .tt-search svg { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); width: 1rem; height: 1rem; color: #94a3b8; pointer-events: none; }
.tt-count { font-size: 0.75rem; color: #64748b; margin-left: auto; }
.tt-pager { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1.25rem; border-top: 1px solid #e6ebfa; font-size: 0.75rem; color: #64748b; }
.tt-pager button { border: 1px solid #d5ddf3; background: #fff; border-radius: 0.6rem; padding: 0.35rem 0.8rem; color: #334155; font-weight: 600; transition: all 0.2s ease; }
.tt-pager button:hover:not(:disabled) { border-color: rgba(79, 70, 229, 0.5); color: #4f46e5; }
.tt-pager button:disabled { opacity: 0.35; cursor: not-allowed; }
th[data-sort] { cursor: pointer; user-select: none; white-space: nowrap; }
th[data-sort]:hover { color: #1e293b; }
th[data-sort]::after { content: "↕"; margin-left: 0.4rem; opacity: 0.35; font-size: 0.7rem; }
th[data-sort][data-dir="asc"]::after { content: "↑"; opacity: 1; color: #4f46e5; }
th[data-sort][data-dir="desc"]::after { content: "↓"; opacity: 1; color: #4f46e5; }

/* sidebar navigation for dashboard panels */
.side-tab { display: flex; width: 100%; align-items: center; gap: 0.75rem; border-radius: 0.85rem; padding: 0.6rem 0.75rem; font-size: 0.875rem; font-weight: 500; color: #475569; transition: all 0.2s ease; text-align: left; }
.side-tab:hover { background: rgba(99, 102, 241, 0.08); color: #1e1b4b; }
.side-tab.active { color: #fff; font-weight: 600; }
.side-tab .badge { margin-left: auto; border-radius: 999px; background: rgba(245, 158, 11, 0.18); color: #b45309; font-size: 10px; font-weight: 700; padding: 1px 7px; }
[data-accent="cyan"] .side-tab.active { background-image: linear-gradient(to right, rgba(59, 130, 246, 0.9), rgba(99, 102, 241, 0.85)); }
[data-accent="emerald"] .side-tab.active { background-image: linear-gradient(to right, rgba(16, 185, 129, 0.55), rgba(13, 148, 136, 0.35)); }
[data-accent="amber"] .side-tab.active { background-image: linear-gradient(to right, rgba(245, 158, 11, 0.55), rgba(234, 88, 12, 0.35)); }
[data-accent="violet"] .side-tab.active { background-image: linear-gradient(to right, rgba(124, 58, 237, 0.9), rgba(168, 85, 247, 0.85)); }
[data-accent="sky"] .side-tab.active { background-image: linear-gradient(to right, rgba(37, 99, 235, 0.9), rgba(79, 70, 229, 0.85)); }
[data-panel]:not([hidden]) { animation: fadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }

/* command palette */
.palette { width: min(34rem, 100%); border-radius: 1.25rem; overflow: hidden; animation: popIn 0.25s cubic-bezier(0.22, 1, 0.36, 1); }
.palette input { width: 100%; background: transparent; padding: 1.1rem 1.25rem; font-size: 0.95rem; color: #1e293b; outline: none; border-bottom: 1px solid #e6ebfa; }
.palette ul { max-height: 18rem; overflow-y: auto; padding: 0.5rem; }
.palette li button { display: flex; width: 100%; align-items: center; gap: 0.75rem; border-radius: 0.75rem; padding: 0.6rem 0.75rem; font-size: 0.875rem; color: #334155; text-align: left; }
.palette li button[aria-selected="true"], .palette li button:hover { background: rgba(99, 102, 241, 0.1); color: #1e1b4b; }
.kbd { border: 1px solid #cbd5e1; border-bottom-width: 2px; border-radius: 0.4rem; padding: 0 0.4rem; font-size: 10px; font-weight: 700; color: #94a3b8; font-family: ui-monospace, monospace; }

/* charts */
.chart-bar { transition: height 0.9s cubic-bezier(0.22, 1, 0.36, 1), y 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
.donut-seg { transition: stroke-dasharray 1s cubic-bezier(0.22, 1, 0.36, 1); cursor: pointer; }
.donut-seg:hover { filter: brightness(1.25); }

/* star rating input */
.stars button { color: #cbd5e1; transition: transform 0.15s ease, color 0.15s ease; }
.stars button.on { color: #fbbf24; }
.stars button:hover { transform: scale(1.18); }

/* password strength */
.strength span { height: 4px; flex: 1; border-radius: 99px; background: #dbe3f5; transition: background 0.3s ease; }

.skeleton { background: linear-gradient(90deg, rgba(99, 102, 241, 0.06), rgba(99, 102, 241, 0.14), rgba(99, 102, 241, 0.06)); background-size: 200% 100%; animation: shimmer 1.6s linear infinite; border-radius: 0.6rem; }

/* export chips (Excel / CSV / PDF) */
.tt-export { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem; border: 1px solid rgba(99, 102, 241, 0.22); border-radius: 999px; background: #fff; }
.tt-export-label { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0 0.45rem 0 0.6rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #64748b; }
.tt-export-label svg { width: 0.9rem; height: 0.9rem; color: #4f46e5; }
.tt-export button { border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.72rem; font-weight: 700; color: #4338ca; background: rgba(99, 102, 241, 0.08); transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease; }
.tt-export button:hover { background: linear-gradient(100deg, #2563eb, #4f46e5 55%, #7c3aed); color: #fff; transform: translateY(-1px); }

/* plans: compare toggle, selected card, floating pill and side-by-side table */
.cmp-toggle { position: absolute; top: 0.75rem; right: 0.75rem; z-index: 10; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.28rem 0.7rem 0.28rem 0.45rem; border-radius: 999px; background: rgba(255, 255, 255, 0.94); border: 1px solid rgba(99, 102, 241, 0.25); font-size: 0.7rem; font-weight: 700; color: #475569; cursor: pointer; backdrop-filter: blur(8px); transition: border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease; }
.cmp-toggle:hover { border-color: rgba(79, 70, 229, 0.6); color: #4338ca; }
.cmp-toggle input { appearance: none; -webkit-appearance: none; width: 1rem; height: 1rem; margin: 0; border-radius: 0.3rem; border: 1.5px solid #94a3b8; background: #fff; display: grid; place-content: center; cursor: pointer; transition: all 0.2s ease; }
.cmp-toggle input:checked { background: linear-gradient(135deg, #2563eb, #7c3aed); border-color: transparent; }
.cmp-toggle input:checked::after { content: "✓"; color: #fff; font-size: 0.68rem; line-height: 1; font-weight: 800; }
.cmp-toggle:has(input:checked) { border-color: rgba(79, 70, 229, 0.65); color: #4338ca; box-shadow: 0 6px 16px -8px rgba(79, 70, 229, 0.6); }
.cmp-full .cmp-toggle:not(:has(input:checked)) { opacity: 0.5; }
.glass.is-compared { box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.6), 0 18px 44px -20px rgba(79, 70, 229, 0.5); }

.cmp-pill { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); z-index: 60; display: flex; align-items: center; gap: 0.75rem; max-width: calc(100vw - 7rem); padding: 0.5rem 0.6rem 0.5rem 0.55rem; border-radius: 999px; background: #fff; border: 1px solid rgba(99, 102, 241, 0.3); box-shadow: 0 18px 44px -16px rgba(49, 46, 129, 0.45); font-size: 0.8rem; color: #334155; animation: fadeUp 0.35s cubic-bezier(0.22, 1, 0.36, 1) both; }
.cmp-pill[hidden] { display: none; }
.cmp-count { display: grid; place-items: center; min-width: 2.1rem; height: 2.1rem; padding: 0 0.5rem; border-radius: 999px; background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; font-weight: 800; }
.cmp-count small { font-weight: 600; opacity: 0.75; }
.cmp-msg { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmp-view, .cmp-clear { border-radius: 999px; padding: 0.4rem 0.85rem; font-size: 0.72rem; font-weight: 700; transition: all 0.2s ease; }
.cmp-view { display: inline-flex; align-items: center; gap: 0.3rem; background: rgba(99, 102, 241, 0.1); color: #4338ca; }
.cmp-view:hover { background: #4f46e5; color: #fff; }
.cmp-pill.seen .cmp-view { display: none; }
.cmp-clear { color: #64748b; }
.cmp-clear:hover { color: #e11d48; }
@@media (max-width: 640px) { .cmp-pill { left: 1rem; transform: none; } .cmp-msg { display: none; } }

.cmp-in { animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
