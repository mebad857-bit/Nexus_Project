@* Strength bar (site.js) + live checklist (password-meter.js) for the password field with id Model. *@
@model string
<span class="mt-2 flex items-center gap-2">
    <span data-strength-for="@Model" class="strength flex flex-1 gap-1"><span></span><span></span><span></span><span></span></span>
    <span data-strength-label class="w-16 text-right text-[11px] font-semibold text-slate-400"></span>
</span>
<ul data-pw-rules-for="@Model" class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs text-slate-500">
    <li data-rule="len" class="flex items-center gap-2"><span data-dot class="h-1.5 w-1.5 shrink-0 rounded-full"></span>6 or more characters</li>
    <li data-rule="mix" class="flex items-center gap-2"><span data-dot class="h-1.5 w-1.5 shrink-0 rounded-full"></span>Upper and lower case</li>
    <li data-rule="num" class="flex items-center gap-2"><span data-dot class="h-1.5 w-1.5 shrink-0 rounded-full"></span>A number</li>
    <li data-rule="sym" class="flex items-center gap-2"><span data-dot class="h-1.5 w-1.5 shrink-0 rounded-full"></span>A symbol (! @@ # …)</li>
</ul>
