@model TabBarVm
<div data-tabbar data-accent="@Model.Gradient" class="glass mb-8 flex w-fit max-w-full items-center gap-1 overflow-x-auto rounded-2xl p-1.5 lg:hidden">
    @foreach (var t in Model.Tabs)
    {
        <button type="button" data-tab="@t.Id" class="tab-btn flex shrink-0 items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition">
            <i data-lucide="@t.Icon" class="h-4 w-4"></i>
            @t.Label
        </button>
    }
</div>
