@* Photo box with Upload / Change / Remove buttons. Talks to /api/images/{resource}/{id} (see wwwroot/js/images.js). *@
@model (string Resource, int Id, string? Url, string Name, string Label)
<div data-img-manager data-resource="@Model.Resource" data-id="@Model.Id" class="flex items-center gap-5">
    <span class="relative grid h-24 w-24 shrink-0 place-items-center overflow-hidden rounded-2xl bg-gradient-to-br from-cyan-500/30 to-violet-500/30 font-display text-2xl font-bold text-white ring-1 ring-cyan-400/30">
        <span data-img-initials>@Fmt.Initials(Model.Name)</span>
        <img data-img-preview src="@Model.Url" alt="@Model.Label" onerror="this.style.display='none'" class="absolute inset-0 h-full w-full object-cover @(string.IsNullOrEmpty(Model.Url) ? "hidden" : "")" />
    </span>
    <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">@Model.Label</p>
        <p class="mt-1 text-xs text-slate-600">JPG, PNG, WEBP or GIF · max 3 MB</p>
        <div class="mt-3 flex flex-wrap gap-2">
            <input type="file" data-img-file accept="image/jpeg,image/png,image/webp,image/gif" hidden />
            <button type="button" data-img-pick class="rounded-lg border border-slate-700/70 px-3 py-1.5 text-xs font-semibold text-slate-300 transition hover:border-cyan-400/50 hover:text-cyan-300">@(string.IsNullOrEmpty(Model.Url) ? "Upload photo" : "Change photo")</button>
            <button type="button" data-img-remove class="rounded-lg border border-slate-700/70 px-3 py-1.5 text-xs font-semibold text-slate-400 transition hover:border-rose-400/50 hover:text-rose-300 @(string.IsNullOrEmpty(Model.Url) ? "hidden" : "")">Remove</button>
        </div>
        <p data-img-msg class="mt-2 text-xs text-rose-300"></p>
    </div>
</div>
