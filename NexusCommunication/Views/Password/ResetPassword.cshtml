@model ResetVm
@{
    ViewData["Title"] = "Reset password — Nexus Communication System";
}
<main class="relative flex min-h-screen items-center justify-center px-5 py-16 sm:px-10">
    <div class="grid-bg absolute inset-0 opacity-70"></div>
    <div class="pointer-events-none absolute left-1/2 top-[-8rem] h-72 w-[30rem] -translate-x-1/2 rounded-full bg-violet-600/12 blur-[110px]"></div>

    <div class="fade-up relative w-full max-w-md" style="--d:0s">
        <a href="/login" class="mb-8 inline-flex items-center gap-2 text-sm text-slate-500 transition hover:text-cyan-300">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Back to sign in
        </a>

        <div class="glass-strong rounded-[1.75rem] p-8 sm:p-10">
            <div class="flex items-center gap-3">
                <img src="~/images/brand/logo-mark.png" alt="Nexus" class="h-12 w-auto drop-shadow-[0_0_12px_rgba(56,189,248,0.5)]" />
                <div>
                    <h1 class="font-display text-xl font-bold text-slate-100">Choose a new password</h1>
                    <p class="text-xs text-slate-500">@(Model.Valid && !string.IsNullOrEmpty(Model.Username) ? "For account " + Model.Username : "Nexus account recovery")</p>
                </div>
            </div>

            @if (Model.Done)
            {
                <div class="mt-8" role="status">
                    <span class="grid h-14 w-14 place-items-center rounded-full bg-emerald-400/10 ring-1 ring-emerald-400/40">
                        <i data-lucide="circle-check" class="h-7 w-7 text-emerald-300"></i>
                    </span>
                    <h2 class="mt-5 font-display text-lg font-bold text-slate-100">Password updated</h2>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">You can now sign in with your new password.</p>
                    <a href="/login" class="btn-glow mt-6 flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white">
                        Go to sign in <i data-lucide="arrow-right" class="h-4 w-4"></i>
                    </a>
                </div>
            }
            else if (!Model.Valid)
            {
                <div class="mt-8" role="alert">
                    <span class="grid h-14 w-14 place-items-center rounded-full bg-rose-400/10 ring-1 ring-rose-400/40">
                        <i data-lucide="link-2-off" class="h-7 w-7 text-rose-300"></i>
                    </span>
                    <h2 class="mt-5 font-display text-lg font-bold text-slate-100">This link cannot be used</h2>
                    <p class="mt-2 text-sm leading-relaxed text-slate-400">It has expired, was already used, or a newer link replaced it. Reset links work once.</p>
                    <a href="/forgot-password" class="btn-glow mt-6 flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white">
                        Get a new link <i data-lucide="arrow-right" class="h-4 w-4"></i>
                    </a>
                </div>
            }
            else
            {
                <form method="post" action="/reset-password" class="mt-8 space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@Model.Token" />
                    <label class="block">
                        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">New password</span>
                        <span class="relative block">
                            <input id="rp-new" name="Password" type="password" required minlength="6" maxlength="100" autocomplete="new-password" autofocus class="field pr-11" />
                            <button type="button" data-toggle-pass="rp-new" aria-label="Show password" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-200"><i data-lucide="eye" class="h-4 w-4"></i></button>
                        </span>
                        @await Html.PartialAsync("_PasswordMeter", "rp-new")
                    </label>
                    <label class="block">
                        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Repeat new password</span>
                        <input id="rp-rep" name="Confirm" type="password" required autocomplete="new-password" class="field" />
                        <span data-pw-match-for="rp-rep" data-pw-with="rp-new" class="mt-1.5 block text-xs font-semibold" aria-live="polite"></span>
                    </label>

                    @if (!string.IsNullOrEmpty(Model.Error))
                    {
                        <p role="alert" class="flex items-start gap-2 text-sm text-rose-300">
                            <i data-lucide="circle-alert" class="mt-0.5 h-4 w-4 shrink-0"></i>
                            <span>@Model.Error</span>
                        </p>
                    }

                    <button class="btn-glow flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white">
                        <i data-lucide="shield-check" class="h-4 w-4"></i> Update password
                    </button>
                </form>
            }
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/password-meter.js" asp-append-version="true"></script>
}
