@model ForgotVm
@{
    ViewData["Title"] = "Forgot password — Nexus Communication System";
}
<main class="relative flex min-h-screen items-center justify-center px-5 py-16 sm:px-10">
    <div class="grid-bg absolute inset-0 opacity-70"></div>
    <div class="pointer-events-none absolute left-1/2 top-[-8rem] h-72 w-[30rem] -translate-x-1/2 rounded-full bg-violet-600/12 blur-[110px]"></div>

    <div class="fade-up relative w-full max-w-md" style="--d:0s">
        <a href="/login" class="mb-8 inline-flex items-center gap-2 text-sm text-slate-500 transition hover:text-cyan-300">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Back to sign in
        </a>

        <div class="glass-strong rounded-[1.75rem] p-8 sm:p-10">
            <div class="flex items-center gap-3">
                <img src="~/images/brand/logo-mark.png" alt="Nexus" class="h-12 w-auto drop-shadow-[0_0_12px_rgba(56,189,248,0.5)]" />
                <div>
                    <h1 class="font-display text-xl font-bold text-slate-100">Forgot your password?</h1>
                    <p class="text-xs text-slate-500">We'll prepare a one-time reset link</p>
                </div>
            </div>

            @if (Model.Done)
            {
                <div class="mt-8" role="status">
                    <span class="grid h-14 w-14 place-items-center rounded-full bg-emerald-400/10 ring-1 ring-emerald-400/40">
                        <i data-lucide="@(Model.Link != null ? "link" : "mail-check")" class="h-7 w-7 text-emerald-300"></i>
                    </span>
                    @if (Model.Link != null)
                    {
                        <h2 class="mt-5 font-display text-lg font-bold text-slate-100">Your reset link is ready</h2>
                        <p class="mt-2 text-sm leading-relaxed text-slate-400">
                            E-mail is not set up on this server (demo mode), so the link is shown here instead of being sent.
                            It works once and expires in @Model.ExpiryMinutes minutes.
                        </p>
                        <a href="@Model.Link" class="btn-glow mt-5 flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white">
                            Choose a new password <i data-lucide="arrow-right" class="h-4 w-4"></i>
                        </a>
                        <label class="mt-4 block">
                            <span class="mb-1.5 block text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Or copy the link</span>
                            <input readonly value="@Model.Link" onfocus="this.select()" class="field font-mono text-xs" aria-label="Reset link" />
                        </label>
                    }
                    else
                    {
                        <h2 class="mt-5 font-display text-lg font-bold text-slate-100">Check your inbox</h2>
                        <p class="mt-2 text-sm leading-relaxed text-slate-400">
                            If an account matches what you entered, a reset link@(string.IsNullOrEmpty(Model.MaskedEmail) ? "" : " is on its way to " + Model.MaskedEmail).
                            It works once and expires in @Model.ExpiryMinutes minutes. Nothing arrived? Look in your spam folder or try again.
                        </p>
                    }
                    <a href="/login" class="mt-6 inline-block text-sm font-semibold text-cyan-300 hover:underline">Back to sign in</a>
                </div>
            }
            else
            {
                <form method="post" action="/forgot-password" class="mt-8 space-y-4">
                    @Html.AntiForgeryToken()
                    <label class="block">
                        <span class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Username or e-mail</span>
                        <span class="relative block">
                            <i data-lucide="user" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500"></i>
                            <input name="Identifier" value="@Model.Identifier" required maxlength="200" autocomplete="username" autofocus placeholder="your username or e-mail address" class="field pl-11" />
                        </span>
                    </label>

                    @if (!string.IsNullOrEmpty(Model.Error))
                    {
                        <p role="alert" class="flex items-start gap-2 text-sm text-rose-300">
                            <i data-lucide="circle-alert" class="mt-0.5 h-4 w-4 shrink-0"></i>
                            <span>@Model.Error</span>
                        </p>
                    }

                    <button class="btn-glow flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white">
                        <i data-lucide="send" class="h-4 w-4"></i> Get reset link
                    </button>
                </form>
                <p class="mt-6 text-center text-xs text-slate-500">Remembered it? <a href="/login" class="font-semibold text-cyan-300 hover:underline">Sign in</a></p>
            }
        </div>
    </div>
</main>
