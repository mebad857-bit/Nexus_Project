@{
    ViewData["Title"] = "Contact us — Nexus Communication System";
    var info = new[]
    {
        (Icon: "map-pin", Label: "Head office", Value: "1 Signal Plaza, Meridian Central"),
        (Icon: "phone", Label: "Phone", Value: "+1 555 0100"),
        (Icon: "mail", Label: "E-mail", Value: "care@nexuscomm.com"),
    };
}
<main class="relative min-h-screen">
    @await Html.PartialAsync("_Nav")
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[34rem] overflow-hidden">
        <div class="grid-bg absolute inset-0"></div>
        <div class="absolute left-1/2 top-[-10rem] h-96 w-[50rem] -translate-x-1/2 rounded-full bg-cyan-500/10 blur-[130px]"></div>
    </div>

    <section class="relative mx-auto max-w-6xl px-5 pb-24 pt-36 lg:px-8">
        @await Html.PartialAsync("_SectionHeader", ("Contact us", "Talk to the <span class=\"text-gradient\">network desk.</span>",
            (string?)"Plan questions, billing help or a note for the team — leave your details and we'll reply by e-mail.", true))

        <div class="mt-14 grid gap-8 lg:grid-cols-5">
            <div class="space-y-4 lg:col-span-2">
                @foreach (var i in info)
                {
                    <div class="glass card-hover flex items-center gap-4 rounded-3xl p-6">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-cyan-500/15 to-violet-500/15 ring-1 ring-slate-700">
                            <i data-lucide="@i.Icon" class="h-5 w-5 text-cyan-300"></i>
                        </span>
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">@i.Label</p>
                            <p class="mt-0.5 font-semibold text-slate-200">@i.Value</p>
                        </div>
                    </div>
                }
                <div class="glass flex items-start gap-4 rounded-3xl p-6 text-sm leading-relaxed text-slate-400">
                    <i data-lucide="help-circle" class="mt-0.5 h-5 w-5 shrink-0 text-cyan-400/70"></i>
                    <p>Looking for a quick answer? The <a href="/faq" class="font-semibold text-cyan-300 hover:underline">FAQ page</a> covers orders, billing and bulk schemes.</p>
                </div>
                @if (Ui.AssetExists("/images/hero/contact-support"))
                {
                    <figure class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-slate-800/80 bg-gradient-to-br from-cyan-500/10 to-violet-600/10">
                        <img src="@Ui.Asset("/images/hero/contact-support")" alt="Nexus customer care desk" loading="lazy" onerror="this.parentElement.style.display='none'" class="absolute inset-0 h-full w-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/40 via-transparent to-transparent"></div>
                    </figure>
                }
            </div>

            <div class="lg:col-span-3">
                <div class="glass-strong relative overflow-hidden rounded-[2rem] p-8 sm:p-10">
                    <div class="absolute -right-20 -top-20 h-56 w-56 rounded-full bg-violet-600/15 blur-3xl"></div>
                    <div id="contact-done" hidden class="py-10 text-center">
                        <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-emerald-400/10 ring-1 ring-emerald-400/40">
                            <i data-lucide="circle-check" class="h-8 w-8 text-emerald-300"></i>
                        </span>
                        <h3 class="mt-6 font-display text-2xl font-bold text-slate-100">Message received</h3>
                        <p class="mt-2 text-sm text-slate-400">Thank you — we'll get back to you by e-mail.</p>
                        <button type="button" id="contact-again" class="mt-8 rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-cyan-400/50 hover:text-cyan-300">Send another message</button>
                    </div>

                    <form id="contact-form" class="relative space-y-4" novalidate>
                        <h3 class="font-display text-2xl font-bold text-slate-100">Send us a message</h3>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <label class="block">
                                <span class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Your name</span>
                                <input name="name" required maxlength="200" autocomplete="name" class="field" />
                            </label>
                            <label class="block">
                                <span class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">E-mail</span>
                                <input name="email" type="email" required maxlength="200" autocomplete="email" class="field" />
                            </label>
                        </div>
                        <label class="block">
                            <span class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">Message</span>
                            <textarea name="message" required rows="6" maxlength="4000" class="field resize-none" placeholder="How can we help?"></textarea>
                        </label>
                        <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
                            <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
                        </div>
                        <button id="contact-btn" class="btn-glow flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white disabled:opacity-60">
                            <i data-lucide="send" class="h-4 w-4"></i>
                            <span id="contact-label">Send message</span>
                        </button>
                        <p id="contact-error" hidden class="text-sm text-rose-300"></p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_Footer")
</main>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('contact-form'); if (!form) return;
            var btn = document.getElementById('contact-btn'), label = document.getElementById('contact-label');
            var err = document.getElementById('contact-error'), done = document.getElementById('contact-done');
            function fail(msg) { err.textContent = msg; err.hidden = false; }
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                err.hidden = true;
                var fd = new FormData(form);
                var name = String(fd.get('name') || '').trim(), email = String(fd.get('email') || '').trim(), message = String(fd.get('message') || '').trim();
                if (!name) return fail('Please tell us your name.');
                if (!/^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/.test(email)) return fail('Enter a valid e-mail address so we can reply.');
                if (message.length < 5) return fail('Please write a few words so we can help.');
                btn.disabled = true; label.textContent = 'Sending…';
                var res = await nx.api('/api/contact', { method: 'POST', body: { name: name, email: email, message: message, website: fd.get('website') } });
                btn.disabled = false; label.textContent = 'Send message';
                if (res.ok) { form.reset(); form.hidden = true; done.hidden = false; nx.icons(); nx.toast('Thank you — your message has been received', 'success'); }
                else fail(nx.errText(res, 'Could not send your message — please retry.'));
            });
            document.getElementById('contact-again').addEventListener('click', function () { done.hidden = true; form.hidden = false; });
        })();
    </script>
}
