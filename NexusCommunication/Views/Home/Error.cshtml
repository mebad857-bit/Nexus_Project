@model ErrorVm
@{
    var notFound = Model.Code == 404;
    ViewData["Title"] = (notFound ? "Page not found" : "Something went wrong") + " — Nexus";
    var title = notFound ? "Signal lost" : Model.Code == 403 ? "Access restricted" : "Something went wrong";
    var text = notFound ? "We could not find the page you were looking for. It may have been moved, or the link is mistyped."
        : Model.Code == 403 ? "Your account does not have permission to open this page."
        : "Something went wrong on our side. Please try again in a moment.";
}
<main class="relative grid min-h-screen place-items-center overflow-hidden px-5">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="pointer-events-none absolute left-1/2 top-[-6rem] h-72 w-[30rem] -translate-x-1/2 rounded-full bg-violet-600/15 blur-[110px]"></div>
    <div class="glass-strong fade-up relative max-w-md rounded-3xl p-10 text-center">
        <img src="~/images/brand/logo.png" alt="Nexus Service Marketing" class="mx-auto mb-4 h-24 w-auto" />
        <img src="@Ui.Asset("/images/misc/error-signal-lost")" alt="Signal lost illustration" loading="lazy" onerror="this.style.display='none'" class="mx-auto mb-6 aspect-[2/1] w-full rounded-2xl object-cover" />
        <p class="text-gradient font-display text-7xl font-bold">@Model.Code</p>
        <h1 class="mt-3 font-display text-2xl font-bold text-slate-100">@title</h1>
        <p class="mt-3 text-sm text-slate-400">@text</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/" class="btn-glow inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold text-white"><i data-lucide="house" class="h-4 w-4"></i>Back to site</a>
            <a href="/track" class="inline-flex items-center gap-2 rounded-xl border border-slate-700 px-6 py-3 text-sm font-semibold text-slate-300 transition hover:border-cyan-400/50 hover:text-cyan-300"><i data-lucide="scan-search" class="h-4 w-4"></i>Track an order</a>
        </div>
    </div>
</main>
