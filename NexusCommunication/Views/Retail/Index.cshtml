@model RetailVm
@{
    ViewData["Title"] = "Retail Outlet Desk — Nexus";
    ViewData["Role"] = "retail";
    ViewData["RoleLabel"] = "Retail Outlet";
    ViewData["ScopeName"] = User.ToSession().ScopeName;
    Layout = "_DashboardLayout";

    var tabs = new (string, string, string)[] { ("order", "Place Order", "clipboard-list"), ("book", "Order Book", "scroll-text"), ("customers", "Customers", "contact"), ("connections", "Connections", "signal"), ("collections", "Collections", "hand-coins") };
    ViewData["NavTabs"] = tabs;
    string J(object o) => System.Text.Json.JsonSerializer.Serialize(o);
    var open = Model.Bills.Where(b => b.Status != BillStatus.Paid).ToList();
    const string Lbl = "mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500";
    const string Th = "px-5 py-4 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500";
}

<div>
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="font-display text-3xl font-bold tracking-tight text-slate-100">Retail Outlet Desk</h1>
            <p class="mt-1.5 text-sm text-slate-500">Place connection orders, follow their feasibility, and collect payments right at the counter.</p>
        </div>
    </div>

    <div class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @Ui.StatCard("scroll-text", "Orders booked", Fmt.Num(Model.Orders), "At your outlet", "violet")
        @Ui.StatCard("clipboard-list", "Awaiting feasibility", Fmt.Num(Model.Pending), "With technical desk", "amber")
        @Ui.StatCard("signal", "Connections live", Fmt.Num(Model.Connected), "Provisioned from your orders", "cyan")
        @Ui.StatCard("coins", "Collected by you", Fmt.Money(Model.Collected), "Counter receipts", "emerald")
    </div>

    @await Html.PartialAsync("_TabBar", new TabBarVm("violet", tabs))

    <!-- ----------------------------- place order ----------------------------- -->
    <section data-panel="order" hidden>
        @await Html.PartialAsync("_DeskHero", ("retail", "Outlet counter", "Customer service", "Order desk"))

        <div id="order-success" hidden class="glass-strong mx-auto max-w-xl rounded-[2rem] p-10 text-center">
            <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-emerald-400/10 ring-1 ring-emerald-400/40">
                <i data-lucide="circle-check" class="h-8 w-8 text-emerald-300"></i>
            </span>
            <h3 class="mt-6 font-display text-2xl font-bold text-slate-100">Order lodged with the network</h3>
            <p class="mt-2 text-sm text-slate-400">Hand this order ID to the customer — it drives every status check.</p>
            <p id="order-success-id" class="mt-6 font-mono text-4xl font-bold tracking-[0.14em] text-gradient"></p>
            <div class="mt-8 flex justify-center gap-3">
                <button type="button" id="copy-order-id" data-copy="" class="flex items-center gap-2 rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-cyan-400/50 hover:text-cyan-300"><i data-lucide="copy" class="h-4 w-4"></i>Copy id</button>
                <button type="button" id="book-another" class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-cyan-400/50 hover:text-cyan-300">Book another</button>
                <button type="button" id="open-book" class="btn-glow rounded-xl px-5 py-2.5 text-sm font-semibold text-white">Open order book</button>
            </div>
        </div>

        <form id="order-form" class="grid gap-6 lg:grid-cols-5">
            <div class="glass-strong space-y-5 rounded-3xl p-7 lg:col-span-3">
                <div class="flex items-center justify-between">
                    <h3 class="font-display text-lg font-bold text-slate-100">Applicant</h3>
                    <div class="glass flex rounded-full p-1 text-xs font-semibold">
                        <button type="button" data-mode="new" class="seg active flex items-center gap-1.5 rounded-full px-3.5 py-1.5 capitalize transition"><i data-lucide="user-plus" class="h-3.5 w-3.5"></i>new customer</button>
                        <button type="button" data-mode="existing" class="seg flex items-center gap-1.5 rounded-full px-3.5 py-1.5 capitalize transition"><i data-lucide="users" class="h-3.5 w-3.5"></i>existing customer</button>
                    </div>
                </div>

                <label id="existing-box" hidden class="block">
                    <span class="@Lbl">Registered customer</span>
                    <select id="cust-id" class="field">
                        <option value="" disabled selected>Pick a customer…</option>
                        @foreach (var c in Model.Customers) { <option value="@c.Id">@c.Name · @c.Phone</option> }
                    </select>
                </label>

                <div id="new-box" class="grid gap-4 sm:grid-cols-2">
                    <input name="name" required placeholder="Full name *" class="field" />
                    <input name="phone" required placeholder="Contact number *" class="field" />
                    <input name="email" placeholder="Email" class="field" />
                    <input name="altPhone" placeholder="Alternate contact" class="field" />
                    <select name="city" required class="field">
                        <option value="" disabled selected>City *</option>
                        @foreach (var c in Fmt.Cities) { <option value="@c.Name">@c.Name (@c.Code)</option> }
                    </select>
                    <input name="idProof" placeholder="ID proof reference" class="field" />
                    <textarea name="address" required placeholder="Installation address *" rows="2" class="field resize-none sm:col-span-2"></textarea>
                </div>
            </div>

            <div class="glass-strong flex flex-col rounded-3xl p-7 lg:col-span-2">
                <h3 class="font-display text-lg font-bold text-slate-100">Connection &amp; plan</h3>
                <label class="mt-5 block">
                    <span class="@Lbl">Plan</span>
                    <select id="plan-id" required class="field">
                        <option value="" disabled selected>Choose tariff…</option>
                        @foreach (var g in new[] { ("dialup", "Dial-Up (deposit $325)"), ("broadband", "Broadband (deposit $500)"), ("landline", "Landline (deposit $250)") })
                        {
                            <optgroup label="@g.Item2">
                                @foreach (var p in Model.Plans.Where(p => p.ConnectionType == g.Item1))
                                {
                                    <option value="@p.Id" data-type="@p.ConnectionType" data-price="@Fmt.Dec(p.Price)" data-deposit="@Fmt.Dec(p.Deposit)">@p.Category · @p.Name — @Fmt.Money(p.Price)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <label class="mt-4 block">
                    <span class="@Lbl">Lines (bulk &amp; corporate)</span>
                    <input id="qty" type="number" min="1" max="10000" value="1" class="field" />
                    <span class="mt-1.5 block text-xs text-slate-600">Corporate slabs: 10–14 lines 25% · 15–24 lines 50% · 25–50 lines 75% · above 50 lines 100% off advance &amp; deposit.</span>
                </label>

                <div id="plan-summary" hidden class="mt-5 flex-1 space-y-2.5 rounded-2xl border border-slate-800 bg-ink-900/60 p-5 text-sm">
                    <div class="flex items-center justify-between"><span class="text-slate-400">Plan charge</span><span id="sum-price" class="font-display font-bold text-slate-100"></span></div>
                    <div class="flex items-center justify-between"><span class="text-slate-400" id="sum-dep-label">Security deposit × 1</span><span id="sum-deposit" class="font-display font-bold text-slate-100"></span></div>
                    <div id="sum-discount-row" hidden class="flex items-center justify-between text-emerald-300">
                        <span class="flex items-center gap-1.5"><i data-lucide="badge-percent" class="h-4 w-4"></i> <span id="sum-discount-label"></span></span>
                        <span id="sum-discount" class="font-display font-bold"></span>
                    </div>
                    <p class="pt-1 text-xs text-slate-500">Rebate applies to advance rental &amp; deposit. 12.24% service tax extra.</p>
                </div>

                <p id="order-error" class="mt-4 text-sm text-rose-300"></p>
                <button id="order-submit" disabled class="btn-glow mt-5 flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white disabled:opacity-50">
                    <span data-icon-slot><i data-lucide="clipboard-list" class="h-4 w-4"></i></span>
                    Lodge the order
                </button>
            </div>
        </form>
    </section>

    <!-- ------------------------------ order book ------------------------------ -->
    <section data-panel="book" hidden>
        @await Html.PartialAsync("_TabBanner", ("retail", "book", "Order book", "Orders placed at your outlet"))

        <div class="space-y-5">
            <div>
                <h3 class="font-display text-lg font-bold text-slate-100">Orders placed at this outlet</h3>
                <p class="mt-1 text-sm text-slate-500">Click an order id to copy it for the customer. Remarks from the technical desk explain every feasibility decision.</p>
            </div>
            <div class="glass overflow-hidden rounded-3xl" data-table data-page-size="10" data-search-placeholder="Search order id, customer, plan…" data-export="orders" data-export-filter="#book-filter">
              <div data-tt-extra>
                <select id="book-filter" class="field !w-auto !py-2 text-xs">
                    <option value="all">Every status</option>
                    <option value="pending">Feasibility pending</option>
                    <option value="feasible">Feasible</option>
                    <option value="infeasible">Not feasible</option>
                    <option value="connected">Connected</option>
                    <option value="cancelled">Cancelled</option>
                </select>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[760px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">
                        @foreach (var h in new[] { "Order ID", "Customer", "Type", "Plan", "Placed", "Status" }) { <th data-sort class="@Th">@h</th> }
                    </tr></thead>
                    <tbody>
                        @if (Model.ShopOrders.Count == 0) { <tr><td colspan="6" class="px-5 py-8">@Ui.Empty("No orders yet", "Lodge the first order from the Place Order panel.")</td></tr> }
                        @foreach (var o in Model.ShopOrders)
                        {
                            <tr class="table-row" data-book-row data-status="@o.Status">
                                <td class="px-5 py-3.5">
                                    <button type="button" data-copy="@o.OrderNo" title="Copy order id" class="font-mono text-xs font-bold tracking-wider text-violet-300 hover:underline">@o.OrderNo</button>
                                    @if (o.Corporate) { <p class="text-[10px] text-emerald-300">BULK ×@o.Quantity · @o.DiscountPct% off</p> }
                                </td>
                                <td class="px-4 py-3.5"><p class="font-semibold text-slate-200">@o.Customer.Name</p><p class="text-xs text-slate-500">@o.Customer.Phone</p></td>
                                <td class="px-4 py-3.5">@Ui.TypeChip(o.ConnectionType)</td>
                                <td class="px-4 py-3.5 text-xs text-slate-400">@o.Plan?.Category · @o.Plan?.Name</td>
                                <td class="px-4 py-3.5 text-xs text-slate-500" data-v="@o.CreatedAt.ToString("yyyy-MM-dd")">@Fmt.Date(o.CreatedAt)</td>
                                <td class="px-5 py-3.5">@Ui.Pill(o.Status, Fmt.OrderStatus(o.Status))@if (!string.IsNullOrEmpty(o.Remark)) { <p class="mt-1 max-w-[16rem] text-[11px] leading-snug text-slate-500">@o.Remark</p> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
              </div>
            </div>
        </div>
    </section>

    <!-- ------------------------------ customers ------------------------------ -->
    <section data-panel="customers" hidden>
        @await Html.PartialAsync("_TabBanner", ("retail", "customers", "Customers", "Walk-in and registered customers"))

        <div class="space-y-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h3 class="font-display text-lg font-bold text-slate-100">Customer records</h3>
                    <p class="mt-1 text-sm text-slate-500">Keep contact details, address and ID-proof references up to date.</p>
                </div>
                <button type="button" id="add-customer" class="btn-glow flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold text-white"><i data-lucide="user-plus" class="h-4 w-4"></i>Add customer</button>
            </div>
            <div class="glass overflow-hidden rounded-3xl" data-table data-page-size="10" data-search-placeholder="Search name, phone, city…" data-export="customers"><div class="overflow-x-auto">
                <table class="w-full min-w-[680px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">
                        @foreach (var h in new[] { "Customer", "Contact", "City", "ID proof" }) { <th data-sort class="@Th">@h</th> }
                        <th class="@Th text-right">Actions</th>
                    </tr></thead>
                    <tbody>
                        @if (Model.Customers.Count == 0) { <tr><td colspan="5" class="px-5 py-8">@Ui.Empty("No customers yet")</td></tr> }
                        @foreach (var c in Model.Customers)
                        {
                            <tr class="table-row">
                                <td class="px-5 py-3.5"><div class="flex items-center gap-3">@Ui.Thumb(c.ImageUrl, c.Name, Fmt.Initials(c.Name), "h-9 w-9", "rounded-xl", "bg-violet-400/10 text-violet-300")<p class="font-semibold text-slate-200">@c.Name</p></div></td>
                                <td class="px-5 py-3.5"><p class="text-slate-300">@c.Phone</p><p class="text-xs text-slate-500">@c.Email</p></td>
                                <td class="px-5 py-3.5 text-slate-400">@c.City</td>
                                <td class="px-5 py-3.5 text-xs text-slate-500">@(c.IdProof ?? "—")</td>
                                <td class="px-5 py-3.5 text-right">
                                    <button type="button" data-edit-customer="@c.Id" class="rounded-lg border border-slate-700/70 px-2.5 py-1.5 text-[11px] font-semibold text-slate-300 transition hover:border-violet-400/50 hover:text-violet-300">Edit</button>
                                    <button type="button" data-order-for="@c.Id" class="ml-1 rounded-lg border border-violet-400/40 px-2.5 py-1.5 text-[11px] font-semibold text-violet-300 transition hover:bg-violet-400/10">New order</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div></div>
        </div>
    </section>

    <!-- ------------------------------ connections ------------------------------ -->
    <section data-panel="connections" hidden>
        @await Html.PartialAsync("_TabBanner", ("retail", "connections", "Connections", "Lines activated from your orders"))

        @if (Model.Connections.Count == 0)
        {
            @Ui.Empty("No connections provisioned yet", "Connections appear here once the technical desk activates feasible orders from your outlet.")
        }
        else
        {
            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var c in Model.Connections)
                {
                    <div class="glass card-hover rounded-3xl p-6">
                        <div class="flex items-center justify-between">@Ui.TypeChip(c.ConnectionType) @Ui.Pill(c.Status, Fmt.ConnStatus(c.Status))</div>
                        <p class="mt-5 font-mono text-lg font-bold tracking-wider text-slate-100">@c.AccountId</p>
                        <p class="mt-1 text-sm font-semibold text-slate-300">@c.Customer.Name</p>
                        <p class="text-xs text-slate-500">@c.Plan?.Category · @c.Plan?.Name</p>
                        <div class="mt-5 flex items-center justify-between border-t border-slate-800 pt-4 text-xs text-slate-500">
                            <span>@c.City · @c.CityCode</span>
                            <span>Live since @Fmt.Date(c.ActivatedAt)</span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ------------------------------ collections ------------------------------ -->
    <section data-panel="collections" hidden>
        @await Html.PartialAsync("_TabBanner", ("retail", "collections", "Collections", "Counter receipts you have taken"))

        <div class="grid gap-6 lg:grid-cols-3">
            <div class="glass overflow-hidden rounded-3xl lg:col-span-2">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 px-6 py-4">
                    <h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Open invoices · collect at counter</h3>
                    <div data-export-slot="bills" data-export-label="Invoices"></div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[640px] text-sm">
                        <tbody>
                            @if (open.Count == 0)
                            {
                                <tr><td class="px-6 py-8">@Ui.Empty("Nothing outstanding", "Every invoice raised on your outlet's connections is settled.")</td></tr>
                            }
                            @foreach (var b in open)
                            {
                                <tr class="table-row align-top">
                                    <td class="px-6 py-4">
                                        <p class="font-mono text-xs text-slate-400">@b.BillNo</p>
                                        <p class="font-semibold text-slate-200">@b.Connection.Customer.Name</p>
                                        <p class="text-xs text-slate-500">@b.Connection.AccountId · @b.Period</p>
                                        <form hidden data-collect-form="@b.Id" class="mt-3 flex flex-wrap items-center gap-2">
                                            <input name="amount" type="number" step="0.01" min="0.01" max="@Fmt.Dec(b.DueAmount)" value="@Fmt.Dec(b.DueAmount)" class="field w-32 py-2" required />
                                            <select name="method" class="field w-28 py-2">
                                                <option value="cash" selected>Cash</option><option value="card">Card</option>
                                                <option value="upi">UPI</option><option value="cheque">Cheque</option>
                                            </select>
                                            <button class="btn-glow flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-bold text-white">
                                                <span data-icon-slot><i data-lucide="hand-coins" class="h-3.5 w-3.5"></i></span> Receipt
                                            </button>
                                        </form>
                                    </td>
                                    <td class="px-4 py-4 text-right">
                                        <p class="font-display text-lg font-bold text-slate-100">@Fmt.Money(b.DueAmount)</p>
                                        <p class="text-[11px] text-slate-500">of @Fmt.Money(b.Total)</p>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @Ui.Pill(b.Status, Fmt.BillStatus(b.Status))
                                        <div class="mt-2">
                                            <button type="button" data-collect-toggle="@b.Id" class="rounded-lg border border-violet-400/40 px-3 py-1.5 text-[11px] font-bold text-violet-300 transition hover:bg-violet-400/10">Collect</button>
                                            <a href="/invoice/@b.Id" target="_blank" class="ml-1 rounded-lg border border-slate-700/70 px-3 py-1.5 text-[11px] font-semibold text-slate-300 transition hover:border-cyan-400/50 hover:text-cyan-300">Invoice</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="glass rounded-3xl p-6">
                <h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Recent receipts</h3>
                <div class="mt-5 space-y-3">
                    @if (Model.Payments.Count == 0)
                    {
                        <p class="text-sm text-slate-500">No receipts logged yet.</p>
                    }
                    @foreach (var p in Model.Payments.Take(10))
                    {
                        <div class="flex items-center justify-between rounded-xl border border-slate-800 bg-ink-900/60 px-4 py-3">
                            <div>
                                <p class="font-mono text-[11px] text-slate-500">@p.Bill.BillNo</p>
                                <p class="text-xs text-slate-400">@p.Method.ToUpperInvariant() · @p.Channel · @Fmt.Date(p.CreatedAt)</p>
                            </div>
                            <span class="font-display text-sm font-bold text-emerald-300">@Fmt.Money(p.Amount)</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script type="application/json" id="retail-data">@Html.Raw(J(new {
        customers = Model.Customers.Select(c => new { id = c.Id, name = c.Name, email = c.Email, phone = c.Phone, address = c.Address, city = c.City, idProof = c.IdProof, altPhone = c.AltPhone, imageUrl = c.ImageUrl }),
        cities = Fmt.Cities.Select(c => new { value = c.Name, label = c.Name + " (" + c.Code + ")" }),
    }))</script>
    <script src="~/js/retail.js" asp-append-version="true"></script>
}
