@model AccountsVm
@{
    ViewData["Title"] = "Accounts & Billing — Nexus";
    ViewData["Role"] = "accounts";
    ViewData["RoleLabel"] = "Accounts Desk";
    ViewData["ScopeName"] = "Head Office · Billing Wing";
    Layout = "_DashboardLayout";

    var tabs = new (string, string, string)[] { ("overview", "Overview", "layout-dashboard"), ("generate", "Generate Invoice", "calculator"), ("ledger", "Invoice Ledger", "scroll-text"), ("dues", "Customer Dues", "coins"), ("receipts", "Receipts", "receipt") };
    ViewData["NavTabs"] = tabs;
    string J(object o) => System.Text.Json.JsonSerializer.Serialize(o);
    var periods = new[] { Fmt.MonthLabel(0), Fmt.MonthLabel(1), Fmt.MonthLabel(2), Fmt.MonthLabel(3) };
    const string Lbl = "mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500";
    const string Th = "px-5 py-4 text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500";
}

<div>
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="font-display text-3xl font-bold tracking-tight text-slate-100">Accounts &amp; Billing</h1>
            <p class="mt-1.5 text-sm text-slate-500">Raise postpaid invoices with statutory service tax, and reconcile counter and office collections.</p>
        </div>
    </div>

    <div class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @Ui.StatCard("scroll-text", "Invoices raised", Fmt.Num(Model.Invoices), $"{Model.Open} still open", "cyan")
        @Ui.StatCard("coins", "Outstanding", Fmt.Money(Model.Outstanding), $"{Model.Overdue} overdue", "rose")
        @Ui.StatCard("wallet", "Collected overall", Fmt.Money(Model.Collected), "All channels", "emerald")
        @Ui.StatCard("landmark", "Office collections", Fmt.Money(Model.AtOffice), $"Counter: {Fmt.Money(Model.AtCounter)} · Online: {Fmt.Money(Model.AtOnline)}", "violet")
    </div>

    @await Html.PartialAsync("_TabBar", new TabBarVm("emerald", tabs))


    <!-- ------------------------------ overview ------------------------------ -->
    <section data-panel="overview" hidden>
        @await Html.PartialAsync("_DeskHero", ("accounts", "Billing & invoicing", "Payment collection", "Revenue analytics"))

        <div class="space-y-6">
            <div class="grid gap-6 lg:grid-cols-3">
                <div class="glass rounded-3xl p-6 lg:col-span-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Invoiced vs collected</h3>
                        <div class="flex gap-4 text-xs text-slate-400"><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-cyan-400"></i>Invoiced</span><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-emerald-400"></i>Collected</span></div>
                    </div>
                    <div class="mt-4" data-chart="bars" data-source="acc-monthly"></div>
                    <script type="application/json" id="acc-monthly">@Html.Raw(J(Model.Monthly.Select(m => new { label = m.Label, a = m.Invoiced, b = m.Collected })))</script>
                </div>
                <div class="glass rounded-3xl p-6">
                    <h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Where money arrives</h3>
                    @{ var chanTotal = Math.Max(1m, Model.AtCounter + Model.AtOffice + Model.AtOnline); }
                    <div class="mt-6 space-y-5">
                        <div>
                            <div class="flex justify-between text-sm"><span class="text-slate-400">Retail counters</span><span class="font-display font-bold text-violet-300">@Fmt.Money(Model.AtCounter)</span></div>
                            <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-800"><div class="h-full rounded-full bg-gradient-to-r from-violet-500 to-fuchsia-500 transition-all duration-1000" style="width:0" data-bar="@((int)(Model.AtCounter / chanTotal * 100))"></div></div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm"><span class="text-slate-400">Accounts office</span><span class="font-display font-bold text-emerald-300">@Fmt.Money(Model.AtOffice)</span></div>
                            <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-800"><div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-1000" style="width:0" data-bar="@((int)(Model.AtOffice / chanTotal * 100))"></div></div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm"><span class="text-slate-400">Online (demo)</span><span class="font-display font-bold text-sky-300">@Fmt.Money(Model.AtOnline)</span></div>
                            <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-800"><div class="h-full rounded-full bg-gradient-to-r from-sky-500 to-cyan-500 transition-all duration-1000" style="width:0" data-bar="@((int)(Model.AtOnline / chanTotal * 100))"></div></div>
                        </div>
                    </div>
                    <button type="button" data-go-tab="generate" class="btn-glow mt-8 flex w-full items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold text-white"><i data-lucide="plus" class="h-4 w-4"></i>New invoice</button>
                </div>
            </div>
            <div class="grid gap-6 lg:grid-cols-3">
                <div class="glass rounded-3xl p-6 lg:col-span-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Collections vs dues</h3>
                        <div class="flex gap-4 text-xs text-slate-400"><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-emerald-400"></i>Collected</span><span class="flex items-center gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-rose-400"></i>Dues</span></div>
                    </div>
                    <p class="mt-1 text-xs text-slate-500">Payments received each month against what is still unpaid on that month's invoices.</p>
                    <div class="mt-4" data-cjs="collections" data-source="acc-coll-dues"></div>
                    <script type="application/json" id="acc-coll-dues">@Html.Raw(J(Model.CollectionsVsDues.Select(m => new { label = m.Label, collected = m.Collected, dues = m.Dues })))</script>
                </div>
                <div class="glass rounded-3xl p-6">
                    <h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Collected vs outstanding</h3>
                    <div class="mt-4" data-cjs="balance" data-source="acc-balance"></div>
                    <script type="application/json" id="acc-balance">@Html.Raw(J(new { collected = Model.Collected, outstanding = Model.Outstanding }))</script>
                </div>
            </div>
        </div>
    </section>

    <!-- ------------------------------ dues ------------------------------ -->
    <section data-panel="dues" hidden>
        @await Html.PartialAsync("_TabBanner", ("accounts", "dues", "Customer dues", "Who owes what, at a glance"))

        <div class="space-y-5">
            <div>
                <h2 class="font-display text-xl font-bold text-slate-100">Customer dues</h2>
                <p class="mt-1 text-sm text-slate-500">Everyone with unpaid or part-paid invoices, largest balance first.</p>
            </div>
            <div class="glass overflow-hidden rounded-3xl" data-table data-page-size="10" data-search-placeholder="Search customer or phone…" data-export="dues"><div class="overflow-x-auto">
                <table class="w-full min-w-[640px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">
                        @foreach (var h in new[] { "Customer", "Open invoices", "Oldest due date", "Balance" }) { <th data-sort class="@Th">@h</th> }
                    </tr></thead>
                    <tbody>
                        @if (Model.DueRows.Count == 0) { <tr><td colspan="4" class="px-5 py-8 text-center text-sm text-emerald-300">No outstanding balances — everything is settled.</td></tr> }
                        @foreach (var r in Model.DueRows)
                        {
                            <tr class="table-row">
                                <td class="px-5 py-3.5"><div class="flex items-center gap-3">@Ui.Thumb(r.Customer.ImageUrl, r.Customer.Name, Fmt.Initials(r.Customer.Name), "h-10 w-10", "rounded-full", "bg-emerald-400/10 text-emerald-300")<div><p class="font-semibold text-slate-200">@r.Customer.Name</p><p class="text-xs text-slate-500">@r.Customer.Phone · @r.Customer.City</p></div></div></td>
                                <td class="px-5 py-3.5 text-slate-300">@r.Bills</td>
                                <td class="px-5 py-3.5" data-v="@(r.Oldest?.ToString("yyyy-MM-dd"))"><span class="@(r.Overdue ? "text-rose-300" : "text-slate-400")">@Fmt.Date(r.Oldest)</span>@if (r.Overdue) { <span class="ml-2 rounded-full border border-rose-400/40 bg-rose-400/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-rose-300">Overdue</span> }</td>
                                <td class="px-5 py-3.5 font-display font-bold text-rose-300">@Fmt.Money(r.Due)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div></div>
        </div>
    </section>

    <!-- ------------------------------ generate ------------------------------ -->
    <section data-panel="generate" hidden>
        @await Html.PartialAsync("_TabBanner", ("accounts", "generate", "Generate invoice", "Calculate and issue a bill"))

        <form id="invoice-form" class="grid gap-6 lg:grid-cols-5" data-tax="@Fmt.Dec(Fmt.ServiceTaxRate)">
            <div class="glass-strong space-y-5 rounded-3xl p-7 lg:col-span-3">
                <h3 class="font-display text-lg font-bold text-slate-100">Invoice inputs</h3>

                <label class="block">
                    <span class="@Lbl">Connection</span>
                    <select id="inv-conn" required class="field">
                        <option value="" disabled selected>Choose an active account…</option>
                        @foreach (var c in Model.Billable)
                        {
                            <option value="@c.Id" data-price="@Fmt.Dec(c.Plan?.Price ?? 0)" data-type="@c.ConnectionType" data-status="@c.Status" data-due="@Fmt.Dec(Model.DueByConnection.GetValueOrDefault(c.Id))">@c.AccountId · @c.Customer.Name · @c.Plan?.Category @c.Plan?.Name</option>
                        }
                    </select>
                </label>

                <div id="inv-info" hidden class="flex flex-wrap items-center gap-3 rounded-2xl border border-slate-800 bg-ink-900/60 px-4 py-3">
                    <span id="inv-type"></span>
                    <span id="inv-status"></span>
                    <span class="text-xs text-slate-500">Plan charge <span id="inv-plan-price"></span> / cycle</span>
                    <span id="inv-due-note" hidden class="ml-auto rounded-full border border-amber-400/40 bg-amber-400/10 px-3 py-1 text-[11px] font-semibold text-amber-300"></span>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <label class="block"><span class="@Lbl">Plan rental ($)</span>
                        <input id="inv-rental" type="number" step="0.01" min="0" required class="field" /></label>
                    <label class="block"><span class="@Lbl">Usage / call charges ($)</span>
                        <input id="inv-usage" type="number" step="0.01" min="0" class="field" placeholder="Metered local / STD / messaging" /></label>
                    <label class="block"><span class="@Lbl">Discount ($)</span>
                        <input id="inv-discount" type="number" step="0.01" min="0" class="field" placeholder="Schemes, goodwill, replacements" /></label>
                    <label class="block"><span class="@Lbl">Billing period</span>
                        <select id="inv-period" class="field">
                            @foreach (var p in periods) { <option value="@p">@p</option> }
                        </select></label>
                </div>

                <p id="inv-error" class="text-sm text-rose-300"></p>
                <p id="inv-done" hidden class="flex items-center gap-2 text-sm text-emerald-300">
                    <i data-lucide="circle-check" class="h-4 w-4"></i> Invoice <span id="inv-done-no" class="font-mono font-bold"></span> published to the customer.
                </p>

                <button id="inv-submit" disabled class="btn-glow flex w-full items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-display text-sm font-bold uppercase tracking-wider text-white disabled:opacity-50">
                    <span data-icon-slot><i data-lucide="receipt" class="h-4 w-4"></i></span>
                    Publish invoice
                </button>
            </div>

            <div class="glass-strong flex flex-col rounded-3xl p-7 lg:col-span-2">
                <h3 class="flex items-center gap-2 font-display text-lg font-bold text-slate-100">
                    <i data-lucide="calculator" class="h-5 w-5 text-emerald-300"></i>
                    Live computation
                </h3>
                <div class="mt-6 flex-1 space-y-3.5 text-sm">
                    <div class="flex items-center justify-between"><span class="text-slate-400">Plan rental</span><span id="pv-rental" class="font-display font-bold text-slate-100">$0.00</span></div>
                    <div class="flex items-center justify-between"><span class="text-slate-400">Usage &amp; calls</span><span id="pv-usage" class="font-display font-bold text-slate-100">$0.00</span></div>
                    <div class="flex items-center justify-between"><span class="text-slate-400">Discount</span><span id="pv-discount" class="font-display font-bold text-emerald-300">− $0.00</span></div>
                    <div class="border-t border-dashed border-slate-700/80 pt-3.5">
                        <div class="flex items-center justify-between"><span class="text-slate-400">Subtotal</span><span id="pv-subtotal" class="font-display font-bold text-slate-100">$0.00</span></div>
                    </div>
                    <div class="flex items-center justify-between"><span class="text-slate-400">Service tax @@ @Fmt.ServiceTaxRate%</span><span id="pv-tax" class="font-display font-bold text-amber-300">$0.00</span></div>
                </div>
                <div class="mt-6 rounded-2xl bg-gradient-to-r from-emerald-500/15 to-teal-500/10 p-5 ring-1 ring-emerald-400/30">
                    <p class="text-xs uppercase tracking-[0.2em] text-emerald-300/80">Invoice total</p>
                    <p id="pv-total" class="mt-1 font-display text-4xl font-bold text-emerald-300">$0.00</p>
                    <p class="mt-1 text-xs text-slate-500">Due within 10 days of issue · payable at any counter or the office</p>
                </div>
            </div>
        </form>
    </section>

    <!-- ------------------------------- ledger ------------------------------- -->
    <section data-panel="ledger" hidden>
        @await Html.PartialAsync("_TabBanner", ("accounts", "ledger", "Invoice ledger", "Every invoice, paid and pending"))

        <div class="space-y-5">
            <div>
                <h3 class="font-display text-lg font-bold text-slate-100">Invoice ledger</h3>
                <p class="mt-1 text-sm text-slate-500">Search, sort and filter. Open an invoice to print it or save it as a PDF.</p>
            </div>

            <div class="glass overflow-hidden rounded-3xl" data-table data-page-size="8" data-search-placeholder="Search invoice, account, customer…" data-export="bills" data-export-filter="#ledger-filter">
              <div data-tt-extra>
                <select id="ledger-filter" class="field !w-auto !py-2 text-xs">
                    <option value="all">Every status</option>
                    <option value="pending">Unpaid</option>
                    <option value="partial">Partially paid</option>
                    <option value="paid">Paid</option>
                </select>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[880px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">
                        @foreach (var h in new[] { "Invoice", "Account / customer", "Period", "Total", "Paid", "Due", "Status" }) { <th data-sort class="@Th">@h</th> }<th class="@Th"></th>
                    </tr></thead>
                    <tbody id="ledger-body">
                        <tr id="ledger-empty" @(Model.Bills.Count == 0 ? "" : "hidden")><td colspan="8" class="px-5 py-8">@Ui.Empty("No invoices in this view", "Generate an invoice or relax the filter.")</td></tr>
                        @foreach (var b in Model.Bills)
                        {
                            <tr class="table-row align-top" data-bill-row data-status="@b.Status">
                                <td class="px-5 py-4">
                                    <p class="font-mono text-xs font-bold text-emerald-300">@b.BillNo</p>
                                    <p class="mt-0.5 text-[11px] text-slate-500">by @(b.GeneratedBy ?? "accounts") · @Fmt.Date(b.CreatedAt)</p>
                                    <form hidden data-pay-form="@b.Id" class="mt-3 flex flex-wrap items-center gap-2">
                                        <input name="amount" type="number" step="0.01" min="0.01" max="@Fmt.Dec(b.DueAmount)" value="@Fmt.Dec(b.DueAmount)" required class="field w-32 py-2" />
                                        <select name="method" class="field w-28 py-2">
                                            <option value="cash" selected>Cash</option><option value="card">Card</option>
                                            <option value="upi">UPI</option><option value="cheque">Cheque</option>
                                        </select>
                                        <button class="btn-glow flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-bold text-white">
                                            <span data-icon-slot><i data-lucide="hand-coins" class="h-3.5 w-3.5"></i></span> Post
                                        </button>
                                    </form>
                                </td>
                                <td class="px-4 py-4">
                                    <p class="font-semibold text-slate-200">@b.Connection.Customer.Name</p>
                                    <p class="font-mono text-[11px] text-slate-500">@b.Connection.AccountId</p>
                                </td>
                                <td class="px-4 py-4 text-slate-400">@b.Period</td>
                                <td class="px-4 py-4 font-display font-bold text-slate-100">@Fmt.Money(b.Total)</td>
                                <td class="px-4 py-4 text-emerald-300">@Fmt.Money(b.PaidAmount)</td>
                                <td class="px-4 py-4 text-rose-300">@Fmt.Money(b.DueAmount)</td>
                                <td class="px-4 py-4">@Ui.Pill(b.Status, Fmt.BillStatus(b.Status))</td>
                                <td class="px-5 py-4 text-right">
                                    <div class="flex flex-col items-end gap-2">
                                    <a href="/invoice/@b.Id" target="_blank" class="rounded-lg border border-slate-700/70 px-3 py-1.5 text-[11px] font-semibold text-slate-300 transition hover:border-cyan-400/50 hover:text-cyan-300">Open / print</a>
                                    @if (b.Status != BillStatus.Paid)
                                    {
                                        <button type="button" data-pay-toggle="@b.Id" class="rounded-lg border border-emerald-400/40 px-3 py-1.5 text-[11px] font-bold text-emerald-300 transition hover:bg-emerald-400/10">Collect at office</button>
                                    }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
              </div>
            </div>
        </div>
    </section>

    <!-- ------------------------------ receipts ------------------------------ -->
    <section data-panel="receipts" hidden>
        @await Html.PartialAsync("_TabBanner", ("accounts", "receipts", "Receipts", "Payments received and their references"))

        @if (Model.Payments.Count == 0)
        {
            @Ui.Empty("No receipts yet", "Payments posted by the counter or this desk will appear here.")
        }
        else
        {
            <div class="glass overflow-hidden rounded-3xl" data-table data-page-size="10" data-search-placeholder="Search reference, customer, method…" data-export="payments"><div class="overflow-x-auto">
                <table class="w-full min-w-[760px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">
                        @{ var heads = new[] { "Reference", "Invoice", "Customer", "Channel", "Method", "Received by", "Date", "Amount" }; }
                        @for (var i = 0; i < heads.Length; i++) { <th data-sort class="@Th @(i == heads.Length - 1 ? "text-right" : "")">@heads[i]</th> }
                    </tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr class="table-row">
                                <td class="px-5 py-3.5 font-mono text-xs text-slate-400">@p.Reference</td>
                                <td class="px-4 py-3.5 font-mono text-xs text-emerald-300/80">@p.Bill.BillNo</td>
                                <td class="px-4 py-3.5">
                                    <p class="font-semibold text-slate-200">@p.Bill.Connection.Customer.Name</p>
                                    <p class="font-mono text-[11px] text-slate-500">@p.Bill.Connection.AccountId</p>
                                </td>
                                <td class="px-4 py-3.5">
                                    <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider @(p.Channel == "retail" ? "border-violet-400/40 bg-violet-400/10 text-violet-300" : p.Channel == "online" ? "border-sky-400/40 bg-sky-400/10 text-sky-300" : "border-emerald-400/40 bg-emerald-400/10 text-emerald-300")">@(p.Channel == "retail" ? "Counter" : p.Channel == "online" ? "Online · demo" : "Office")</span>
                                </td>
                                <td class="px-4 py-3.5 uppercase text-xs text-slate-400">@p.Method</td>
                                <td class="px-4 py-3.5 text-xs text-slate-400">@p.ReceivedBy</td>
                                <td class="px-4 py-3.5 text-xs text-slate-500" data-v="@p.CreatedAt.ToString("yyyy-MM-dd")">@Fmt.Date(p.CreatedAt)</td>
                                <td class="px-5 py-3.5 text-right font-display font-bold text-emerald-300">@Fmt.Money(p.Amount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div></div>
        }
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <script src="~/js/accounts.js" asp-append-version="true"></script>
}
