                <table class="w-full min-w-[720px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">
                        @foreach (var h in new[] { "Order", "Question", "Published" }) { <th data-sort class="@Th">@h</th> }
                        <th class="@Th text-right">Actions</th>
                    </tr></thead>
                    <tbody>
                        @if (Model.Faqs.Count == 0)
                        {
                            <tr><td colspan="4" class="px-5 py-8">@Ui.Empty("No FAQs yet", "Use “Add question” to publish the first one.")</td></tr>
                        }
                        @foreach (var r in Model.Faqs)
                        {
                            <tr class="table-row">
                                <td class="px-5 py-3.5 font-mono text-xs text-slate-500">@r.SortOrder</td>
                                <td class="px-5 py-3.5"><p class="font-semibold text-slate-200">@r.Question</p><p class="mt-0.5 line-clamp-2 max-w-xl text-xs text-slate-500">@r.Answer</p></td>
                                <td class="px-5 py-3.5">@Ui.Pill(r.Active ? "active" : "inactive", r.Active ? "Live" : "Hidden")</td>
                                <td class="px-5 py-3.5"><div class="flex items-center justify-end gap-2">
                                    <button type="button" data-edit="faqs" data-id="@r.Id" class="@ActBtn">Edit</button>
                                    <button type="button" data-crud-patch="faqs" data-id="@r.Id" data-body='{"active":@(r.Active ? "false" : "true")}' class="@ActBtn">@(r.Active ? "Hide" : "Publish")</button>
                                    <button type="button" data-crud-delete="faqs" data-id="@r.Id" title="Delete" class="@DelBtn"><i data-lucide="trash-2" class="h-3.5 w-3.5"></i></button>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div></div>
        </div>
    </section>

    <!-- ------------------------------ activity log ------------------------------ -->
    <section data-panel="activity" hidden>
        @await Html.PartialAsync("_TabBanner", ("admin", "activity", "Activity log", "Who changed what, and when"))

        <div class="space-y-5" id="audit-root">
            <div>
                <h2 class="font-display text-xl font-bold text-slate-100">Activity log</h2>
                <p class="mt-1 text-sm text-slate-500">Every change made in the system — who did it, when, and what changed (old → new values for edits). Read-only: nobody can edit or delete these entries.</p>
            </div>

            <div class="glass overflow-hidden rounded-3xl">
                <div class="tt-bar">
                    <select id="audit-user" aria-label="Filter by user" class="field !w-auto !py-2 text-xs"><option value="">All users</option></select>
                    <select id="audit-action" aria-label="Filter by action" class="field !w-auto !py-2 text-xs">
                        <option value="">All actions</option>
                        @foreach (var (val, label) in new[] { ("create", "Created"), ("update", "Edited"), ("delete", "Deleted"), ("status", "Status change"), ("payment", "Payment"), ("image", "Picture"), ("login", "Sign in"), ("logout", "Sign out") })
                        {
                            <option value="@val">@label</option>
                        }
                    </select>
                    <label class="flex items-center gap-2 text-xs text-slate-500">From <input type="date" id="audit-from" class="field !w-auto !py-2 text-xs" /></label>
                    <label class="flex items-center gap-2 text-xs text-slate-500">To <input type="date" id="audit-to" class="field !w-auto !py-2 text-xs" /></label>
                    <div class="tt-search"><i data-lucide="search"></i><input type="search" id="audit-q" class="field" placeholder="Search details…" aria-label="Search the activity log" /></div>
                    <button type="button" id="audit-reset" class="@ActBtn !py-2">Reset</button>
                    <span class="tt-count" id="audit-count" aria-live="polite"></span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[860px] text-sm">
                        <thead><tr class="border-b border-slate-800 text-left">
                            @foreach (var h in new[] { "When", "User", "Action", "Record", "What changed" }) { <th class="@Th">@h</th> }
                        </tr></thead>
                        <tbody id="audit-body"><tr><td colspan="5" class="px-5 py-10 text-center text-sm text-slate-500">Loading…</td></tr></tbody>
                    </table>
                </div>
                <div class="tt-pager" id="audit-pager" hidden>
                    <span data-info></span>
                    <div class="flex gap-2"><button type="button" data-prev>Previous</button><button type="button" data-next>Next</button></div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script type="application/json" id="registry-data">@Html.Raw(J(new {
        employees = Model.Employees.Select(e => new { e.Id, e.Name, e.Email, e.Phone, e.Department, e.Designation, e.ShopId, e.Status, e.ImageUrl }),
        vendors = Model.Vendors.Select(v => new { v.Id, v.Name, v.ContactPerson, v.Email, v.Phone, v.Address, v.Products, v.ImageUrl }),
        equipment = Model.Equipment.Select(e => new { e.Id, e.Name, e.Type, e.VendorId, e.UnitPrice, e.Stock, e.ReorderLevel, e.ImageUrl }),
        shops = Model.Shops.Select(x => new { x.Id, x.Code, x.Name, x.City, x.Address, x.Phone, x.Manager, x.ImageUrl }),
        plans = Model.Plans.Select(p => new { p.Id, p.ConnectionType, p.Category, p.Name, p.Speed, p.Price, p.ValidityLabel, p.ValidityMonths, p.Deposit, p.CallRates, p.Description, p.ImageUrl }),
        customers = Model.Customers.Select(c => new { c.Id, c.Name, c.Email, c.Phone, c.Address, c.City, c.IdProof, c.AltPhone, c.ImageUrl }),
        faqs = Model.Faqs.Select(f => new { f.Id, f.Question, f.Answer, f.SortOrder }),
        shopOptions = Model.Shops.Select(x => new { value = x.Id.ToString(), label = x.Code + " — " + x.Name }),
        vendorOptions = Model.Vendors.Select(v => new { value = v.Id.ToString(), label = v.Name }),
        cityOptions = Fmt.Cities.Select(c => new { value = c.Name, label = c.Name + " (" + c.Code + ")" }),
    }))</script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/activity.js" asp-append-version="true"></script>
    <script src="~/js/tickets.js" asp-append-version="true"></script>
}
