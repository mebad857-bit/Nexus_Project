    <!-- ------------------------------ procurement ------------------------------ -->
    <section data-panel="procurement" hidden>
        @await Html.PartialAsync("_TabBanner", ("admin", "procurement", "Procurement", "Purchase orders and incoming stock"))

        <div class="space-y-6">
            <div>
                <h2 class="font-display text-xl font-bold text-slate-100">Procurement planning</h2>
                <p class="mt-1 text-sm text-slate-500">Compare live stock with the connections still waiting for hardware, then re-order from the right vendor.</p>
            </div>
            @{
                var modemStock = Model.Equipment.Where(e => e.Type is "modem" or "router").Sum(e => e.Stock);
                var phoneStock = Model.Equipment.Where(e => e.Type is "telephone" or "cabling").Sum(e => e.Stock);
            }
            <div class="grid gap-4 sm:grid-cols-2">
                @Ui.StatCard("wifi", "Modems / routers needed", Fmt.Num(Model.OpenDemandModems), $"{Fmt.Num(modemStock)} in stock", Model.OpenDemandModems > modemStock ? "rose" : "emerald")
                @Ui.StatCard("phone", "Phones / cabling needed", Fmt.Num(Model.OpenDemandPhones), $"{Fmt.Num(phoneStock)} in stock", Model.OpenDemandPhones > phoneStock ? "rose" : "emerald")
            </div>
            <div class="glass overflow-hidden rounded-3xl">
                <div class="border-b border-slate-800 px-6 py-4"><h3 class="font-display text-sm font-bold uppercase tracking-[0.18em] text-slate-300">Reorder suggestions</h3></div>
                <div class="overflow-x-auto"><table class="w-full min-w-[640px] text-sm">
                    <thead><tr class="border-b border-slate-800 text-left">@foreach (var h in new[] { "Product", "Vendor", "In stock", "Reorder at", "Shortfall" }) { <th class="@Th">@h</th> }<th class="@Th text-right">Action</th></tr></thead>
                    <tbody>
                        @{ var low = Model.Equipment.Where(e => e.Stock <= e.ReorderLevel).OrderBy(e => e.Stock - e.ReorderLevel).ToList(); }
                        @if (low.Count == 0) { <tr><td colspan="6" class="px-5 py-8 text-center text-sm text-emerald-300">Every product is above its reorder level.</td></tr> }
                        @foreach (var e in low)
                        {
                            var vendor = Model.Vendors.FirstOrDefault(v => v.Id == e.VendorId);
                            <tr class="table-row">
                                <td class="px-5 py-3.5"><p class="font-semibold text-slate-200">@e.Name</p><p class="text-xs capitalize text-slate-500">@e.Type</p></td>
                                <td class="px-5 py-3.5 text-slate-400">@(vendor?.Name ?? "—")<p class="text-xs text-slate-600">@vendor?.Phone</p></td>
                                <td class="px-5 py-3.5 font-bold text-amber-300">@e.Stock</td>
                                <td class="px-5 py-3.5 text-slate-400">@e.ReorderLevel</td>
                                <td class="px-5 py-3.5 text-rose-300">@(Math.Max(0, e.ReorderLevel * 2 - e.Stock)) units to restore a 2× buffer</td>
                                <td class="px-5 py-3.5 text-right"><button type="button" data-add-stock="@e.Id" data-name="@e.Name" class="@ActBtn">Receive stock</button></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            </div>
        </div>
    </section>

